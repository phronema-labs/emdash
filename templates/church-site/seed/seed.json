			},
			{
				"id": "about",
				"slug": "about",
				"status": "published",
				"data": {
					"title": "About Holy Resurrection",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"children": [{ "_type": "span", "text": "Holy Resurrection Antiochian Orthodox Church is a parish of the Antiochian Orthodox Christian Archdiocese of North America, located in Tucson, Arizona. We are a welcoming community rooted in the ancient Apostolic faith, committed to worship, prayer, and service." }]
						},
						{
							"_type": "block",
							"style": "h2",
							"children": [{ "_type": "span", "text": "Our Vision" }]
						},
						{
							"_type": "block",
							"style": "normal",
							"children": [{ "_type": "span", "text": "To be a vibrant Orthodox Christian community that faithfully preserves and shares the fullness of the Apostolic Faith, welcoming all who seek Christ and nurturing each person's journey toward theosis — union with God." }]
						}
					]
				}
			},
			{
				"id": "contact",
				"slug": "contact",
				"status": "published",
				"data": {
					"title": "Contact Us",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"children": [{ "_type": "span", "text": "We would love to hear from you. Whether you have questions about Orthodoxy, want to plan a visit, or need to reach our clergy, please don't hesitate to get in touch." }]
						}
					]
				}
			},
			{
				"id": "visitors",
				"slug": "visitors",
				"status": "published",
				"data": {
					"title": "Welcome, Visitors",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"children": [{ "_type": "span", "text": "Visiting an Orthodox church for the first time can feel unfamiliar. We want you to know that you are welcome here exactly as you are. You don't need to know what to do — simply come, observe, and let the beauty of the Liturgy speak to your heart." }]
						}
					]
				}
			},
			{
				"id": "donate",
				"slug": "donate",
				"status": "published",
				"data": {
					"title": "Support Our Parish",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"children": [{ "_type": "span", "text": "Your generous support sustains the life of our parish — from worship services and sacraments to education, outreach, and building maintenance. Every gift, large or small, helps us continue our mission." }]
						}
					]
				}
			}
		],
		"ministries": [
			{
				"id": "choir",
				"slug": "choir",
				"status": "published",
				"data": {
					"title": "Church Choir",
					"icon": "ph-music-notes",
					"summary": "Our choir leads the congregation in the beautiful Byzantine and Western chant traditions of the Orthodox Church.",
					"schedule": "Rehearsals: Thursdays at 7:00 PM",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"children": [{ "_type": "span", "text": "The choir serves an essential liturgical role, leading the congregation in worship through sacred music. We welcome singers of all levels who wish to offer their voices in service to God." }]
						}
					]
				},
				"taxonomies": { "ministry_type": ["worship"] }
			},
			{
				"id": "sunday-school",
				"slug": "sunday-school",
				"status": "published",
				"data": {
					"title": "Sunday School",
					"icon": "ph-book-open",
					"summary": "Religious education for children and youth, nurturing their faith through Scripture, tradition, and Orthodox Christian living.",
					"schedule": "Sundays after Holy Communion",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"children": [{ "_type": "span", "text": "Our Sunday School program provides age-appropriate Orthodox Christian education for children from preschool through high school. Students learn about Scripture, the lives of the Saints, Church history, and how to live their faith." }]
						}
					]
				},
				"taxonomies": { "ministry_type": ["education"] }
			},
			{
				"id": "mens-group",
				"slug": "mens-group",
				"status": "published",
				"data": {
					"title": "Men's Group",
					"icon": "ph-users",
					"summary": "Fellowship and spiritual growth for men of the parish through study, service, and community.",
					"schedule": "First Saturday of each month, 8:00 AM",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"children": [{ "_type": "span", "text": "The Men's Group provides a space for men of the parish to grow in faith together through Bible study, book discussions, service projects, and fellowship. All men are welcome." }]
						}
					]
				},
				"taxonomies": { "ministry_type": ["fellowship"] }
			},
			{
				"id": "antiochian-women",
				"slug": "antiochian-women",
				"status": "published",
				"data": {
					"title": "Antiochian Women",
					"icon": "ph-heart",
					"summary": "Women of the parish serving the church and community through fellowship, charity, and spiritual enrichment.",
					"schedule": "Monthly meetings — see calendar",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"children": [{ "_type": "span", "text": "The Antiochian Women chapter supports the parish through charitable works, hospitality, and fellowship. Members organize fundraising events, coordinate meals for parishioners in need, and participate in archdiocesan initiatives." }]
						}
					]
				},
				"taxonomies": { "ministry_type": ["fellowship"] }
			},
			{
				"id": "youth-ministry",
				"slug": "youth-ministry",
				"status": "published",
				"data": {
					"title": "Youth Ministry",
					"icon": "ph-star",
					"summary": "Engaging our teens in faith, service, and community through SOYO and Teen SOYO activities.",
					"schedule": "Bi-weekly meetings — see calendar",
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"children": [{ "_type": "span", "text": "Our youth ministry provides teens with opportunities to deepen their Orthodox faith through retreats, service projects, social events, and regional gatherings with other Antiochian parishes." }]
						}
					]
				},
				"taxonomies": { "ministry_type": ["education"] }
			}
		],
