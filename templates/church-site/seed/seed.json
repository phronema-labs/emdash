		"faqs": [
			{
				"id": "faq-what-to-expect",
				"slug": "what-to-expect",
				"status": "published",
				"data": {
					"question": "What should I expect when visiting for the first time?",
					"answer": [
						{
							"_type": "block",
							"style": "normal",
							"children": [{ "_type": "span", "text": "Orthodox worship is rich and may feel unfamiliar at first. The service involves standing, sitting, chanting, incense, and icons. You are welcome to simply observe — there is no pressure to participate beyond your comfort level. Feel free to arrive a few minutes early, and don't hesitate to ask a greeter for help." }]
						}
					]
				},
				"taxonomies": { "faq_category": ["visiting"] }
			},
			{
				"id": "faq-dress-code",
				"slug": "dress-code",
				"status": "published",
				"data": {
					"question": "Is there a dress code?",
					"answer": [
						{
							"_type": "block",
							"style": "normal",
							"children": [{ "_type": "span", "text": "There is no strict dress code. We encourage modest, respectful attire — what you might wear to a nice dinner. Some women choose to cover their heads during worship, but this is not required. Come as you are; we are glad you are here." }]
						}
					]
				},
				"taxonomies": { "faq_category": ["visiting"] }
			},
			{
				"id": "faq-communion",
				"slug": "who-can-receive-communion",
				"status": "published",
				"data": {
					"question": "Who can receive Holy Communion?",
					"answer": [
						{
							"_type": "block",
							"style": "normal",
							"children": [{ "_type": "span", "text": "Holy Communion is reserved for baptized and chrismated Orthodox Christians who have prepared through fasting, prayer, and recent confession. All visitors are welcome to approach for a blessing — simply cross your arms over your chest." }]
						}
					]
				},
				"taxonomies": { "faq_category": ["orthodoxy"] }
			}
		],
