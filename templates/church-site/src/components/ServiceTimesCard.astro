---
/**
 * Services & Upcoming Events card matching mockup spec.
 * Two-column layout: Services (left) with icon/address, Events (right) with time pills.
 */
import { getEmDashCollection } from "emdash";

const { entries: events } = await getEmDashCollection("events", { status: "published" });
---

<section class="services-card">
	<div class="services-grid">
		<!-- Services column -->
		<div class="services-col">
			<h3 class="col-heading">Services</h3>

			<div class="service-block">
				<span class="service-day">Saturday</span>
				<span class="service-time">Vespers | 5:00 pm</span>
			</div>

			<div class="service-block">
				<span class="service-day">Sunday</span>
				<span class="service-time">Orthros | 9:00 am</span>
				<span class="service-time">Divine Liturgy | 10:00 am</span>
			</div>

			<a href="/events" class="calendar-btn">View Full Calendar</a>

			<div class="services-icon">
				<img src="/images/home/hroc-church-illustration.png" alt="Holy Resurrection Antiochian Orthodox Church" />
			</div>

			<div class="services-address">
				<p>We are located at</p>
				<p class="address-line">5901 E. 5th Street, Tucson, AZ 85711</p>
			</div>
		</div>

		<!-- Events column -->
		<div class="events-col">
			<h3 class="col-heading">Upcoming Events</h3>

			{events.length > 0 ? (
				events.slice(0, 4).map((event) => (
					<div class="event-item">
						<span class="event-title">{event.data.title}</span>
						{event.data.start_date && (
							<span class="event-date">{event.data.start_date}</span>
						)}
						{event.data.description && (
							<div class="event-pill">{event.data.description}</div>
						)}
					</div>
				))
			) : (
				<>
					<div class="event-item">
						<span class="event-title">Sunday Divine Liturgy</span>
						<span class="event-date">Every Sunday</span>
						<div class="event-pill">9:00 AM - Orthros & 10:00 AM - Divine Liturgy</div>
					</div>
					<div class="event-item">
						<span class="event-title">Saturday Vespers</span>
						<span class="event-date">Every Saturday</span>
						<div class="event-pill">5:00 PM - Vespers</div>
					</div>
				</>
			)}
		</div>
	</div>
</section>

<style>
	.services-card {
		max-width: 100%;
		margin: 0;
		padding: 0;
		background: #c5c9ca;
		overflow: hidden;
	}

	.services-grid {
		padding: 3rem 3rem 2rem;
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
	}


	@media (max-width: 600px) {
		.services-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
	}

	.col-heading {
		font-family: var(--font-heading);
		font-size: clamp(1.5rem, 3vw, 2rem);
		color: var(--brand-primary);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		margin-bottom: 1.5rem;
	}

	/* Services column */
	.services-col {
		text-align: center;
	}

	.service-block {
		margin-bottom: 1.25rem;
	}

	.service-day {
		display: block;
		font-family: var(--font-heading);
		font-size: 0.9rem;
		color: var(--brand-primary);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-weight: 700;
		margin-bottom: 0.25rem;
	}

	.service-time {
		display: block;
		font-family: var(--font-body-stack);
		font-size: 1.1rem;
		color: var(--brand-primary);
	}

	.calendar-btn {
		display: inline-block;
		margin-top: 0.75rem;
		margin-bottom: 1.5rem;
		padding: 0.5rem 1.25rem;
		border: 2px solid var(--brand-primary);
		color: var(--brand-primary);
		font-family: var(--font-body-stack);
		font-size: 0.85rem;
		text-decoration: none;
		letter-spacing: 0.04em;
		transition: all 0.2s ease;
	}

	.calendar-btn:hover {
		background: var(--brand-primary);
		color: white;
	}

	.services-icon {
		margin: 0 auto 1rem;
		width: 8rem;
	}

	.services-icon img {
		width: 100%;
		height: auto;
	}

	.services-address {
		font-family: var(--font-body-stack);
		font-size: 0.85rem;
		color: rgba(0, 0, 0, 0.6);
		line-height: 1.5;
	}

	.address-line {
		font-weight: 600;
		color: var(--brand-primary);
	}

	/* Events column */
	.events-col {
		text-align: left;
	}

	.event-item {
		padding-bottom: 1.25rem;
		margin-bottom: 1.25rem;
		border-bottom: 1px solid rgba(0, 0, 0, 0.12);
	}

	.event-item:last-child {
		border-bottom: none;
		margin-bottom: 0;
	}

	.event-title {
		display: block;
		font-family: var(--font-body-stack);
		font-size: 0.95rem;
		color: var(--brand-primary);
		font-weight: 600;
		margin-bottom: 0.15rem;
	}

	.event-date {
		display: block;
		font-family: var(--font-body-stack);
		font-size: 0.8rem;
		color: rgba(0, 0, 0, 0.5);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		margin-bottom: 0.5rem;
	}

	.event-pill {
		display: inline-block;
		padding: 0.35rem 0.75rem;
		background: rgba(0, 0, 0, 0.08);
		font-family: var(--font-body-stack);
		font-size: 0.8rem;
		color: rgba(0, 0, 0, 0.7);
	}
</style>
