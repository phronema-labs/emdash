---
import { getMenu, getSiteSettings } from "emdash";
import { EmDashHead } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { Font } from "astro:assets";
import "../styles/site.css";
import "../styles/brand.css";

interface Props {
	title?: string;
	description?: string;
	image?: string;
	isHome?: boolean;
}

const { title, description, image, isHome = false } = Astro.props;
const settings = await getSiteSettings();
const siteTitle = settings?.title || "Holy Resurrection Antiochian Orthodox Church";
const fullTitle = title ? `${title} — ${siteTitle}` : siteTitle;
const siteDescription = settings?.tagline || "Rooted in Tradition, Alive in Christ";
const siteLogo = (settings?.logo as any)?.url ? settings.logo as { mediaId: string; alt?: string; url: string } : null;
const siteFavicon = (settings?.favicon as any)?.url ?? null;

const menu = await getMenu("primary");
const footerMenu = await getMenu("footer");
const currentPath = Astro.url.pathname;

const pageCtx = createPublicPageContext({
	Astro,
	kind: "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: title ?? siteTitle,
	description: description || siteDescription,
	canonical: Astro.url.href,
	image,
	seo: { ogImage: image },
	siteName: siteTitle,
});
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<link rel="icon" href={siteFavicon || "/favicon.svg"} type="image/svg+xml" />
		<EmDashHead page={pageCtx} />
		<Font cssVariable="--font-body" preload />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Quando&family=Great+Vibes&family=Cinzel:wght@400;600;700&display=swap" rel="stylesheet" />
	</head>
	<body class={isHome ? "is-home" : ""}>
		<a href="#main-content" class="skip-link">Skip to content</a>

		<!-- Header -->
		<header class="site-header">
			<div class="header-bg">
				<nav class="nav">
					<a href="/" class="site-logo">
						<img src="/navigation-hroc-horizontal-logo-cream.png" alt={siteTitle} class="site-logo-img" />
					</a>
					<button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false">
						<svg class="nav-icon-open" width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
						</svg>
						<svg class="nav-icon-close" width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
						</svg>
					</button>
					<div class="nav-links">
						{menu?.items.map((item) => (
							<a
								href={item.url}
								target={item.target}
								class:list={["nav-link", { active: currentPath === item.url }]}
							>
								{item.label}
							</a>
						))}
					</div>
				</nav>
			</div>
			<!-- Ornamental banner border -->
			<div class="nav-banner">
				<img src="/border-section-divider.png" alt="" class="nav-banner-img" />
			</div>
		</header>

		<main id="main-content" class:list={[{ "main-home": isHome, "main-page": !isHome }]}>
			<slot />
		</main>

		<!-- Footer -->
		<footer class="site-footer">
			<div class="footer-banner">
				<img src="/footer-banner.png" alt="" class="footer-banner-img" />
			</div>
			<div class="container footer-content">
				<!-- Navigation -->
				<nav class="footer-nav">
					{menu?.items.map((item) => (
						<a href={item.url}>{item.label}</a>
					))}
				</nav>

				<!-- Main footer grid -->
				<div class="footer-grid">
					<!-- Email signup -->
					<div class="footer-signup">
						<h3 class="footer-heading">Join our Community</h3>
						<p class="footer-signup-text">
							Stay connected to the life of our parish beyond Sunday. Receive gentle updates on feast days,
							gatherings, retreats, and opportunities to grow together in faith and fellowship.
						</p>
						<form class="footer-form" method="POST" action="/contact">
							<input type="text" name="name" placeholder="Full Name" class="footer-input" />
							<input type="email" name="email" placeholder="Email" class="footer-input" />
							<button type="submit" class="footer-submit">Subscribe</button>
						</form>
					</div>

					<!-- Quote -->
					<div class="footer-quote">
						<p class="footer-quote-text">"The disciples were first called Christians in Antioch"</p>
						<p class="footer-quote-cite">Acts 11:26</p>
					</div>
				</div>

				<!-- Photo strip -->
				<div class="footer-photos">
					<img src="/images/footer/footer-image-01.png" alt="Parish Life" loading="lazy" />
					<img src="/images/footer/footer-image-02.png" alt="Parish Life" loading="lazy" />
					<img src="/images/footer/footer-image-03.png" alt="Parish Life" loading="lazy" />
					<img src="/images/footer/footer-image-04.png" alt="Parish Life" loading="lazy" />
					<img src="/images/footer/footer-image-05.png" alt="Parish Life" loading="lazy" />
				</div>

				<!-- Bottom bar -->
				<div class="footer-bottom">
					<div class="footer-bottom-inner">
						<p>&copy; {new Date().getFullYear()} {siteTitle}. All rights reserved.</p>
						<div class="footer-bottom-links">
							{footerMenu?.items.map((item) => (
								<a href={item.url}>{item.label}</a>
							))}
							<a href="/_emdash/admin" class="admin-link">Admin</a>
						</div>
						<p class="footer-powered">
							Built by <a href="https://phronemalabs.com" class="phronema-link">
								<svg width="14" height="14" viewBox="0 0 64 64" fill="none" style="display:inline-block;vertical-align:-2px;margin-right:3px;">
									<circle cx="27" cy="36" r="16" stroke="#C9963A" stroke-width="5.5"/>
									<circle cx="50" cy="12" r="5" fill="#C9963A"/>
								</svg>Phronema Labs</a>
						</p>
					</div>
				</div>
			</div>
		</footer>

		<script>
			// Mobile nav toggle
			const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
			const links = document.querySelector<HTMLElement>(".nav-links");
			toggle?.addEventListener("click", () => {
				const expanded = toggle.getAttribute("aria-expanded") === "true";
				toggle.setAttribute("aria-expanded", String(!expanded));
				links?.classList.toggle("nav-open");
			});

			// Scroll-triggered reveal animations
			const revealEls = document.querySelectorAll(".reveal, .reveal-stagger");
			if (revealEls.length > 0) {
				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								entry.target.classList.add("visible");
								observer.unobserve(entry.target);
							}
						});
					},
					{ threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
				);
				revealEls.forEach((el) => observer.observe(el));
			}
		</script>

		<style is:global>
			@layer base;

			@layer base {
				*, *::before, *::after {
					box-sizing: border-box;
					margin: 0;
					padding: 0;
				}

				:root {
					--color-bg: #F8F4F0;
					--color-text: #292932;
					--color-muted: #64748b;
					--color-border: #e2e8f0;

					--font-display: "Cinzel", Georgia, serif;
					--font-heading: "Cinzel", Georgia, serif;
					--font-body-stack: "Quando", Georgia, serif;
					--font-quote-stack: "Great Vibes", cursive;

					--font-size-xs: 0.75rem;
					--font-size-sm: 0.875rem;
					--font-size-base: 1rem;
					--font-size-md: 1rem;
					--font-size-lg: 1.125rem;
					--font-size-xl: 1.25rem;
					--font-size-2xl: 1.5rem;
					--font-size-3xl: 2rem;
					--font-size-4xl: 2.75rem;
					--font-size-5xl: 3.5rem;
					--font-size-6xl: 4.25rem;
				}

				html { scroll-behavior: smooth; }

				body {
					font-family: var(--font-body-stack);
					font-size: var(--font-size-base);
					line-height: 1.6;
					color: var(--color-text);
					background: var(--color-bg);
					-webkit-font-smoothing: antialiased;
					min-height: 100vh;
				}

				a { color: currentColor; text-decoration: none; }
				img { max-width: 100%; height: auto; display: block; }

				:focus-visible {
					outline: 2px solid var(--brand-accent);
					outline-offset: 2px;
				}

				.skip-link {
					position: absolute;
					top: -100%;
					left: var(--site-gutter);
					background: var(--brand-primary);
					color: white;
					padding: 0.5rem 1rem;
					border-radius: var(--radius-sm);
					font-size: var(--font-size-sm);
					font-weight: 600;
					z-index: 9999;
				}
				.skip-link:focus { top: 0.5rem; }

				h1, h2, h3, h4, h5, h6 {
					font-family: var(--font-heading);
					font-weight: 600;
					line-height: 1.2;
					letter-spacing: 0.04em;
				}
				h1 { font-size: var(--font-size-5xl); }
				h2 { font-size: var(--font-size-3xl); }
				h3 { font-size: var(--font-size-2xl); }

				/* Animations */
				@keyframes fadeInUp {
					from { opacity: 0; transform: translateY(20px); }
					to { opacity: 1; transform: translateY(0); }
				}

				.reveal {
					opacity: 0;
					transform: translateY(28px);
					transition: opacity 0.75s cubic-bezier(0.16, 1, 0.3, 1), transform 0.75s cubic-bezier(0.16, 1, 0.3, 1);
				}
				.reveal.visible { opacity: 1; transform: translateY(0); }

				.reveal-stagger > * {
					opacity: 0;
					transform: translateY(20px);
					transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
				}
				.reveal-stagger.visible > * { opacity: 1; transform: translateY(0); }
				.reveal-stagger.visible > *:nth-child(1) { transition-delay: 0ms; }
				.reveal-stagger.visible > *:nth-child(2) { transition-delay: 90ms; }
				.reveal-stagger.visible > *:nth-child(3) { transition-delay: 180ms; }
				.reveal-stagger.visible > *:nth-child(4) { transition-delay: 270ms; }
				.reveal-stagger.visible > *:nth-child(5) { transition-delay: 360ms; }
				.reveal-stagger.visible > *:nth-child(6) { transition-delay: 450ms; }

				/* Button system */
				.btn {
					display: inline-flex;
					align-items: center;
					justify-content: center;
					gap: 0.5rem;
					padding: 0.75rem 1.5rem;
					font-family: var(--font-body-stack);
					font-size: var(--font-size-sm);
					font-weight: 600;
					letter-spacing: 0.02em;
					border-radius: var(--radius-sm);
					cursor: pointer;
					transition: background 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
					text-decoration: none;
					border: none;
				}
				.btn:hover { transform: translateY(-2px); }
				.btn:active { transform: translateY(0); }

				.btn-primary {
					color: white;
					background: var(--brand-primary);
				}
				.btn-primary:hover {
					background: var(--brand-primary-dark);
					box-shadow: 0 6px 20px rgba(0, 0, 0, 0.2);
				}

				.btn-accent {
					color: var(--brand-primary-dark);
					background: var(--brand-accent);
				}
				.btn-accent:hover {
					background: color-mix(in srgb, var(--brand-accent) 85%, #000);
					box-shadow: var(--shadow-accent);
				}

				.btn-green {
					color: white;
					background: var(--brand-green);
				}
				.btn-green:hover {
					background: color-mix(in srgb, var(--brand-green) 85%, #000);
				}

				.btn-lg {
					padding: 1rem 2rem;
					font-size: var(--font-size-base);
				}

				/* Prose for CMS content */
				.prose h2 {
					margin-top: 2rem;
					margin-bottom: 0.75rem;
				}
				.prose p {
					margin-bottom: 1rem;
					line-height: 1.8;
				}
				.prose p:last-child { margin-bottom: 0; }
			}
		</style>

		<style>
			/* ===== Header ===== */
			.site-header {
				position: relative;
				z-index: 100;
			}

			.header-bg {
				background: var(--brand-primary);
			}

			.nav {
				max-width: var(--site-max-width);
				margin: 0 auto;
				padding: 0 var(--site-gutter);
				display: flex;
				align-items: center;
				height: 80px;
				position: relative;
			}

			.site-logo {
				flex-shrink: 0;
				z-index: 30;
			}

			.site-logo-img {
				height: 3.5rem;
				object-fit: contain;
			}

			.nav-toggle {
				display: none;
				background: none;
				border: none;
				cursor: pointer;
				color: white;
				margin-left: auto;
				padding: 0.5rem;
			}

			.nav-icon-close { display: none; }
			.nav-toggle[aria-expanded="true"] .nav-icon-open { display: none; }
			.nav-toggle[aria-expanded="true"] .nav-icon-close { display: block; }

			.nav-links {
				display: flex;
				gap: var(--space-lg);
				margin-left: auto;
				padding-right: 1rem;
			}

			.nav-link {
				font-family: var(--font-body-stack);
				font-size: var(--font-size-sm);
				color: white;
				padding: 0.5rem 0.75rem;
				transition: color 0.2s ease, background 0.2s ease;
			}

			.nav-link:hover {
				color: var(--brand-accent);
			}

			.nav-link.active {
				background: var(--brand-cream);
				color: var(--brand-primary);
				border-radius: 3px;
			}

			/* Ornamental banner */
			.nav-banner {
				height: 40px;
				background: url('/border-section-divider.png') repeat-x center / auto 100%;
				overflow: hidden;
			}

			.nav-banner-img {
				display: none;
			}

			/* ===== Main ===== */
			.main-home {
				max-width: 100%;
				margin: 0 auto;
			}
			.main-page {
				max-width: var(--site-max-width);
				margin: 0 auto;
				padding-top: 4rem;
			}

			/* ===== Footer ===== */
			.site-footer {
				background: var(--brand-blue);
				color: white;
			}

			.footer-banner {
				width: 100%;
			}

			.footer-banner-img {
				width: 100%;
				height: auto;
				object-fit: cover;
			}

			.footer-content {
				padding: 5rem var(--site-gutter);
			}

			.footer-nav {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 3rem;
				margin-bottom: 4rem;
			}

			.footer-nav a {
				font-family: var(--font-body-stack);
				font-size: var(--font-size-lg);
				color: white;
				transition: color 0.2s ease;
			}

			.footer-nav a:hover {
				color: var(--brand-accent);
			}

			.footer-grid {
				display: grid;
				grid-template-columns: 2fr 3fr;
				gap: 4rem;
				align-items: start;
			}

			.footer-heading {
				font-family: var(--font-heading);
				font-size: var(--font-size-3xl);
				color: var(--brand-accent);
				text-transform: uppercase;
				letter-spacing: 0.05em;
				margin-bottom: 1.5rem;
			}

			.footer-signup-text {
				font-family: var(--font-body-stack);
				font-size: var(--font-size-base);
				color: rgba(255, 255, 255, 0.9);
				line-height: 1.7;
				margin-bottom: 2rem;
				border: 1px solid rgba(255, 255, 255, 0.3);
				padding: 1.5rem;
				border-radius: 6px;
			}

			.footer-form {
				display: flex;
				flex-direction: column;
				gap: 1.25rem;
				margin-bottom: 3rem;
			}

			@media (min-width: 640px) {
				.footer-form {
					flex-direction: row;
					flex-wrap: wrap;
				}
				.footer-input { flex: 1; min-width: 140px; }
			}

			.footer-input {
				padding: 1rem 1.5rem;
				border-radius: 9999px;
				border: none;
				background: white;
				color: var(--brand-blue);
				font-family: var(--font-body-stack);
				font-size: var(--font-size-base);
			}

			.footer-input::placeholder {
				color: color-mix(in srgb, var(--brand-blue) 60%, transparent);
			}

			.footer-submit {
				padding: 1rem 2.5rem;
				border-radius: 9999px;
				border: none;
				background: var(--brand-accent);
				color: var(--brand-blue);
				font-family: var(--font-body-stack);
				font-weight: 600;
				font-size: var(--font-size-base);
				cursor: pointer;
				transition: background 0.2s ease;
			}

			.footer-submit:hover {
				background: color-mix(in srgb, var(--brand-accent) 90%, #fff);
			}

			.footer-quote {
				text-align: right;
				margin-top: 2rem;
			}

			.footer-quote-text {
				font-family: var(--font-quote-stack);
				font-style: italic;
				font-size: clamp(2.5rem, 5vw, 4.5rem);
				color: var(--brand-accent);
				line-height: 1.3;
				letter-spacing: 0.02em;
			}

			.footer-quote-cite {
				font-family: var(--font-body-stack);
				font-size: var(--font-size-2xl);
				color: white;
				margin-top: 2rem;
			}

			.footer-photos {
				display: grid;
				grid-template-columns: repeat(5, 1fr);
				gap: 1rem;
				margin-top: 3rem;
			}

			.footer-photos img {
				width: 100%;
				height: 10rem;
				object-fit: cover;
				border-radius: var(--radius-md);
				box-shadow: var(--shadow-md);
			}

			.footer-bottom {
				border-top: 1px solid rgba(255, 255, 255, 0.2);
				margin-top: 3rem;
			}

			.footer-bottom-inner {
				padding: 1.5rem 0;
				display: flex;
				justify-content: space-between;
				align-items: center;
				flex-wrap: wrap;
				gap: 1rem;
				font-size: var(--font-size-xs);
				color: rgba(255, 255, 255, 0.5);
			}

			.footer-bottom-links {
				display: flex;
				gap: 1.5rem;
			}

			.footer-bottom-links a {
				color: rgba(255, 255, 255, 0.5);
				transition: color 0.2s ease;
			}

			.footer-bottom-links a:hover { color: white; }

			.footer-powered a { color: rgba(255, 255, 255, 0.6); }
			.phronema-link {
				font-weight: 600;
				color: #C9963A !important;
			}

			/* ===== Responsive ===== */
			@media (max-width: 768px) {
				.footer-photos {
					grid-template-columns: repeat(2, 1fr);
				}

				.footer-photos img:last-child {
					display: none;
				}

				.nav-toggle { display: block; }

				.site-logo-img {
					height: 2rem;
				}

				.nav-links {
					display: none;
					position: absolute;
					top: 100%;
					left: 0;
					right: 0;
					background: var(--brand-primary);
					flex-direction: column;
					padding: 1rem 1.5rem;
					gap: 0.25rem;
					z-index: 50;
				}

				.nav-links.nav-open { display: flex; }

				.nav-link {
					padding: 0.75rem;
					border-bottom: 1px solid rgba(255, 255, 255, 0.1);
				}

				.footer-grid {
					grid-template-columns: 1fr;
				}

				.footer-quote { text-align: center; }

				.footer-bottom-inner {
					flex-direction: column;
					text-align: center;
				}

				.footer-bottom-links {
					flex-wrap: wrap;
					justify-content: center;
				}
			}

			@media (max-width: 480px) {
				.site-logo-img {
					height: 1.75rem;
				}
			}
		</style>
	</body>
</html>
