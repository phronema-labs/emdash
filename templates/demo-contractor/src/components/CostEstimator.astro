---
---

<section class="estimator" id="estimator">
	<div class="estimator-wrap">
		<!-- Left panel: dark with copy -->
		<div class="estimator-intro">
			<span class="label-tag">// Ballpark Pricing</span>
			<h2>GET A QUICK ESTIMATE</h2>
			<p>
				Select your project type and details below for an instant price range.
				For an exact fixed-price quote, <a href="/contact">schedule your free in-home consult</a>.
			</p>
			<div class="estimator-trust">
				<div class="estimator-trust-item">
					<i class="ph ph-currency-dollar-simple"></i>
					<span>No obligation</span>
				</div>
				<div class="estimator-trust-item">
					<i class="ph ph-clock"></i>
					<span>30-second estimate</span>
				</div>
				<div class="estimator-trust-item">
					<i class="ph ph-shield-check"></i>
					<span>Fixed-price contracts</span>
				</div>
			</div>
		</div>

		<!-- Right panel: form -->
		<div class="estimator-form-panel" data-estimator>
			<div class="estimator-step">
				<label class="step-label">
					<span class="step-num">01</span>
					What kind of project?
				</label>
				<div class="option-grid" data-field="service">
					<button class="option-btn" data-value="kitchen">
						<i class="ph ph-cooking-pot" />
						<span>Kitchen</span>
					</button>
					<button class="option-btn" data-value="bathroom">
						<i class="ph ph-bathtub" />
						<span>Bathroom</span>
					</button>
					<button class="option-btn" data-value="addition">
						<i class="ph ph-house-line" />
						<span>Addition / ADU</span>
					</button>
				</div>
			</div>

			<div class="estimator-step">
				<label class="step-label">
					<span class="step-num">02</span>
					Project scope?
				</label>
				<div class="option-grid" data-field="type">
					<button class="option-btn" data-value="cosmetic">
						<i class="ph ph-paint-roller" />
						<span>Cosmetic</span>
					</button>
					<button class="option-btn" data-value="full_remodel">
						<i class="ph ph-hammer" />
						<span>Full Remodel</span>
					</button>
					<button class="option-btn" data-value="new_construction">
						<i class="ph ph-blueprint" />
						<span>New Build</span>
					</button>
				</div>
			</div>

			<div class="estimator-step">
				<label class="step-label">
					<span class="step-num">03</span>
					Square footage?
				</label>
				<div class="option-grid" data-field="size">
					<button class="option-btn" data-value="small">
						<i class="ph ph-square" />
						<span>Under 200</span>
					</button>
					<button class="option-btn" data-value="medium">
						<i class="ph ph-squares-four" />
						<span>200–500</span>
					</button>
					<button class="option-btn" data-value="large">
						<i class="ph ph-bounding-box" />
						<span>500+ sqft</span>
					</button>
				</div>
			</div>

			<div class="estimator-result" data-result style="display: none;">
				<div class="result-bar">
					<div class="result-bar-label">Estimated Range</div>
					<div class="result-price" data-price></div>
				</div>
				<p class="result-note">*Ballpark only. Exact fixed-price quote provided after free in-home consultation.</p>
				<a href="/contact" class="result-cta">
					<i class="ph ph-calendar-check"></i>
					Schedule Your Free Estimate
				</a>
			</div>
		</div>
	</div>
</section>

<script>
	document.querySelectorAll<HTMLElement>("[data-estimator]").forEach((form) => {
		const state: Record<string, string> = {};
		const result = form.querySelector<HTMLElement>("[data-result]")!;
		const priceEl = form.querySelector<HTMLElement>("[data-price]")!;

		const PRICES: Record<string, Record<string, Record<string, string>>> = {
			kitchen: {
				cosmetic: { small: "$8K – $15K", medium: "$15K – $25K", large: "$25K – $40K" },
				full_remodel: { small: "$25K – $45K", medium: "$45K – $75K", large: "$75K – $120K" },
				new_construction: { small: "$30K – $55K", medium: "$55K – $90K", large: "$90K – $150K" },
			},
			bathroom: {
				cosmetic: { small: "$5K – $10K", medium: "$10K – $18K", large: "$18K – $30K" },
				full_remodel: { small: "$15K – $30K", medium: "$30K – $50K", large: "$50K – $80K" },
				new_construction: { small: "$20K – $35K", medium: "$35K – $60K", large: "$60K – $90K" },
			},
			addition: {
				cosmetic: { small: "$15K – $30K", medium: "$30K – $60K", large: "$60K – $100K" },
				full_remodel: { small: "$40K – $80K", medium: "$80K – $150K", large: "$150K – $250K" },
				new_construction: { small: "$50K – $100K", medium: "$100K – $200K", large: "$200K – $350K" },
			},
		};

		form.querySelectorAll<HTMLElement>(".option-btn").forEach((btn) => {
			btn.addEventListener("click", () => {
				const field = btn.closest("[data-field]")?.getAttribute("data-field");
				if (!field) return;

				btn.closest(".option-grid")?.querySelectorAll(".option-btn").forEach((b) => b.classList.remove("active"));
				btn.classList.add("active");
				state[field] = btn.dataset.value!;

				if (state.service && state.type && state.size) {
					const price = PRICES[state.service]?.[state.type]?.[state.size] ?? "Call for quote";
					priceEl.textContent = price;
					result.style.display = "block";
					result.scrollIntoView({ behavior: "smooth", block: "nearest" });
				}
			});
		});
	});
</script>

<style>
	.estimator {
		background: var(--color-surface, #f0ede8);
	}

	.estimator-wrap {
		max-width: var(--site-max-width);
		margin: 0 auto;
		display: grid;
		grid-template-columns: 1fr 1.6fr;
	}

	/* Left intro panel */
	.estimator-intro {
		background: #111;
		color: white;
		padding: var(--spacing-3xl, 6rem) var(--spacing-2xl, 4rem);
		display: flex;
		flex-direction: column;
		gap: var(--spacing-lg, 1.75rem);
		justify-content: center;
	}

	.estimator-intro h2 {
		font-family: "Bebas Neue", sans-serif;
		font-size: clamp(2.5rem, 4vw, 4rem);
		line-height: 0.95;
		color: white;
		letter-spacing: 0.04em;
	}

	.estimator-intro p {
		font-family: "DM Sans", sans-serif;
		font-size: 0.9375rem;
		line-height: 1.65;
		color: rgba(255,255,255,0.55);
	}

	.estimator-intro a {
		color: var(--color-primary, #ff6b00);
		text-decoration: underline;
		text-decoration-color: rgba(255,107,0,0.4);
	}

	.estimator-trust {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		margin-top: var(--spacing-md, 1rem);
	}

	.estimator-trust-item {
		display: flex;
		align-items: center;
		gap: 10px;
		font-family: "DM Sans", sans-serif;
		font-size: 13px;
		color: rgba(255,255,255,0.55);
	}

	.estimator-trust-item i {
		font-size: 18px;
		color: var(--color-primary, #ff6b00);
		flex-shrink: 0;
	}

	/* Right form panel */
	.estimator-form-panel {
		background: white;
		padding: var(--spacing-3xl, 6rem) var(--spacing-2xl, 4rem);
		display: flex;
		flex-direction: column;
		gap: var(--spacing-2xl, 4rem);
	}

	.estimator-step {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-md, 1rem);
	}

	.step-label {
		display: flex;
		align-items: center;
		gap: 12px;
		font-family: "DM Sans", sans-serif;
		font-weight: 700;
		font-size: 1rem;
		color: var(--color-text, #141414);
	}

	.step-num {
		font-family: "Bebas Neue", sans-serif;
		font-size: 1.5rem;
		line-height: 1;
		color: var(--color-primary, #ff6b00);
		opacity: 0.5;
	}

	.option-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-sm, 0.5rem);
	}

	.option-btn {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 8px;
		padding: 1.1rem 0.75rem;
		background: var(--color-surface, #f0ede8);
		border: 2px solid transparent;
		cursor: pointer;
		font-family: "DM Sans", sans-serif;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.04em;
		color: var(--color-text, #141414);
		transition: all 0.15s ease;
		border-radius: 2px;
	}

	.option-btn i {
		font-size: 22px;
		color: var(--color-muted, #6b6b6b);
		transition: color 0.15s ease;
	}

	.option-btn:hover {
		border-color: var(--color-primary, #ff6b00);
		background: rgba(255,107,0,0.04);
	}

	.option-btn:hover i {
		color: var(--color-primary, #ff6b00);
	}

	.option-btn.active {
		border-color: var(--color-primary, #ff6b00);
		background: var(--color-primary, #ff6b00);
		color: white;
	}

	.option-btn.active i {
		color: white;
	}

	/* Result */
	.estimator-result {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-md, 1rem);
		animation: slideUp 0.3s ease;
	}

	@keyframes slideUp {
		from { opacity: 0; transform: translateY(12px); }
		to { opacity: 1; transform: translateY(0); }
	}

	.result-bar {
		background: #111;
		padding: 1.5rem 2rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-md, 1rem);
		border-left: 4px solid var(--color-primary, #ff6b00);
	}

	.result-bar-label {
		font-family: "DM Mono", monospace;
		font-size: 10px;
		font-weight: 500;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: rgba(255,255,255,0.45);
	}

	.result-price {
		font-family: "Bebas Neue", sans-serif;
		font-size: 2.5rem;
		line-height: 1;
		color: white;
		letter-spacing: 0.04em;
	}

	.result-note {
		font-family: "DM Sans", sans-serif;
		font-size: 11px;
		color: var(--color-muted, #6b6b6b);
		font-style: italic;
		line-height: 1.5;
	}

	.result-cta {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 0.875rem 1.75rem;
		background: var(--color-primary, #ff6b00);
		color: white;
		font-family: "DM Sans", sans-serif;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		border-radius: 2px;
		text-decoration: none;
		transition: background 0.15s ease, transform 0.15s ease;
		align-self: flex-start;
	}

	.result-cta:hover {
		background: var(--color-primary-dark, #cc5500);
		transform: translateY(-2px);
	}

	.label-tag {
		font-family: "DM Mono", monospace;
		font-size: 11px;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-primary, #ff6b00);
	}

	@media (max-width: 900px) {
		.estimator-wrap {
			grid-template-columns: 1fr;
		}

		.estimator-intro {
			padding: var(--spacing-2xl, 4rem) var(--spacing-xl, 2.5rem);
		}

		.estimator-form-panel {
			padding: var(--spacing-2xl, 4rem) var(--spacing-xl, 2.5rem);
		}
	}

	@media (max-width: 480px) {
		.option-grid {
			grid-template-columns: 1fr;
		}

		.option-btn {
			flex-direction: row;
			justify-content: flex-start;
			padding: 0.875rem 1rem;
		}

		.result-bar {
			flex-direction: column;
			align-items: flex-start;
			gap: 4px;
		}
	}
</style>
