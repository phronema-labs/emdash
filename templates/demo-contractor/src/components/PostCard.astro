---
import { Image } from "emdash/ui";

interface Props {
	title: string;
	excerpt?: string;
	featuredImage?: any;
	href: string;
	date?: string;
}

const { title, excerpt, featuredImage, href, date } = Astro.props;

const formattedDate = date
	? new Date(date).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })
	: null;
---

<a href={href} class="post-card">
	{featuredImage && (
		<div class="post-image">
			<Image image={featuredImage} />
		</div>
	)}
	<div class="post-info">
		{formattedDate && (
			<time class="post-date">
				<i class="ph ph-calendar-blank"></i>
				{formattedDate}
			</time>
		)}
		<h3>{title}</h3>
		{excerpt && <p class="post-excerpt">{excerpt}</p>}
		<span class="post-link">
			Read More <i class="ph ph-arrow-right"></i>
		</span>
	</div>
</a>

<style>
	.post-card {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		border: 1px solid var(--color-border, #d4d0ca);
		text-decoration: none;
		color: var(--color-text, #141414);
		background: white;
		transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
		border-radius: 2px;
	}

	.post-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--shadow-lg, 0 16px 40px rgba(0,0,0,0.12));
		border-color: var(--color-primary, #ff6b00);
	}

	.post-image {
		aspect-ratio: 16/9;
		overflow: hidden;
		background: var(--color-surface, #f0ede8);
	}

	.post-image :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.45s ease;
	}

	.post-card:hover .post-image :global(img) {
		transform: scale(1.04);
	}

	.post-info {
		padding: 1.5rem;
		flex: 1;
		display: flex;
		flex-direction: column;
	}

	.post-date {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		font-family: "DM Mono", monospace;
		font-size: 10px;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-primary, #ff6b00);
		margin-bottom: 0.75rem;
	}

	.post-info h3 {
		font-family: "Bebas Neue", sans-serif;
		font-size: 1.5rem;
		line-height: 1;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--color-text, #141414);
		margin-bottom: 0.6rem;
	}

	.post-excerpt {
		font-family: "DM Sans", sans-serif;
		font-size: 0.875rem;
		color: var(--color-muted, #6b6b6b);
		line-height: 1.6;
		flex: 1;
		margin-bottom: 1.25rem;
	}

	.post-link {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-family: "DM Sans", sans-serif;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-primary, #ff6b00);
		margin-top: auto;
	}

	.post-link i {
		transition: transform 0.2s ease;
	}

	.post-card:hover .post-link i {
		transform: translateX(4px);
	}
</style>
