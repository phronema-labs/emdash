---
interface Props {
	badges?: Array<{
		icon: string;
		label: string;
		sublabel?: string;
	}>;
}

const { badges = [
	{ icon: "ph-shield-check", label: "Licensed & Insured", sublabel: "$2M Coverage" },
	{ icon: "google", label: "4.9 Google Rating", sublabel: "285+ Reviews" },
	{ icon: "ph-clock", label: "Mon–Fri 7AM–5PM", sublabel: "Sat by Appointment" },
	{ icon: "ph-seal-check", label: "5-Year Warranty", sublabel: "On All Workmanship" },
	{ icon: "ph-certificate", label: "BBB Accredited", sublabel: "A+ Rating" },
] } = Astro.props;
---

<div class="trust-bar">
	<div class="trust-inner">
		{badges.map((badge) => (
			<div class="trust-item">
				{badge.icon === "google" ? (
					<svg viewBox="0 0 24 24" width="22" height="22" class="trust-google-icon">
						<path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/>
						<path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
						<path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
						<path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
					</svg>
				) : (
					<i class={`ph ${badge.icon}`} />
				)}
				<div class="trust-text">
					<strong>{badge.label}</strong>
					{badge.sublabel && <span>{badge.sublabel}</span>}
				</div>
			</div>
		))}
	</div>
</div>

<style>
	.trust-bar {
		background: #111;
		border-top: 1px solid rgba(255,255,255,0.05);
		border-bottom: 1px solid rgba(255,255,255,0.05);
		overflow: hidden;
	}

	.trust-inner {
		max-width: var(--site-max-width);
		margin: 0 auto;
		padding: 0 var(--site-gutter);
		display: flex;
		justify-content: stretch;
	}

	.trust-item {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 1.1rem 1.5rem;
		flex: 1;
		border-right: 1px solid rgba(255,255,255,0.06);
		position: relative;
		transition: background 0.15s ease;
	}

	.trust-item:first-child {
		padding-left: 0;
	}

	.trust-item:last-child {
		border-right: none;
	}

	.trust-item:hover {
		background: rgba(255,107,0,0.05);
	}

	/* Top accent line on hover */
	.trust-item::before {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 2px;
		background: var(--color-primary, #ff6b00);
		transform: scaleX(0);
		transition: transform 0.2s ease;
	}

	.trust-item:hover::before {
		transform: scaleX(1);
	}

	.trust-item i {
		font-size: 22px;
		color: var(--color-primary, #ff6b00);
		flex-shrink: 0;
	}

	.trust-google-icon {
		flex-shrink: 0;
	}

	.trust-text {
		display: flex;
		flex-direction: column;
		gap: 1px;
	}

	.trust-text strong {
		font-family: "DM Sans", sans-serif;
		font-size: 0.8125rem;
		font-weight: 600;
		color: rgba(255,255,255,0.85);
		white-space: nowrap;
	}

	.trust-text span {
		font-family: "DM Sans", sans-serif;
		font-size: 11px;
		color: rgba(255,255,255,0.35);
		white-space: nowrap;
	}

	@media (max-width: 900px) {
		.trust-inner {
			flex-wrap: wrap;
		}

		.trust-item {
			flex: 1 1 45%;
			border-right: 1px solid rgba(255,255,255,0.06);
		}

		.trust-item:nth-child(2n) {
			border-right: none;
		}

		.trust-text span {
			display: none;
		}
	}

	@media (max-width: 540px) {
		.trust-item {
			flex: 1 1 100%;
			border-right: none;
			border-bottom: 1px solid rgba(255,255,255,0.06);
		}
	}
</style>
