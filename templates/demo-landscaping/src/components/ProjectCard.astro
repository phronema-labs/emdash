---
import { Image } from "emdash/ui";

interface Props {
	title: string;
	summary?: string;
	featuredImage: any;
	client?: string;
	year?: string;
	href: string;
}

const { title, summary, featuredImage, client, year, href } = Astro.props;
---

<a href={href} class="project-card">
	{featuredImage && (
		<div class="project-image">
			<Image image={featuredImage} />
			<div class="project-hover-overlay">
				<span class="project-view-btn">
					View Project <i class="ph ph-arrow-up-right" />
				</span>
			</div>
		</div>
	)}
	<div class="project-info">
		{(client || year) && (
			<p class="project-meta">
				{client}{client && year && " · "}{year}
			</p>
		)}
		<h3>{title}</h3>
		{summary && <p class="project-summary">{summary}</p>}
	</div>
</a>

<style>
	.project-card {
		display: block;
		border-radius: 24px;
		overflow: hidden;
		background: white;
		border: 1.5px solid var(--color-border-light, #ede8df);
		transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s cubic-bezier(0.16, 1, 0.3, 1);
		text-decoration: none;
		color: var(--color-text, #1e2d1a);
	}

	.project-card:hover {
		transform: translateY(-8px);
		box-shadow: 0 20px 48px rgba(26, 58, 42, 0.12);
	}

	.project-image {
		aspect-ratio: 4/3;
		overflow: hidden;
		position: relative;
	}

	.project-image :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.project-card:hover .project-image :global(img) {
		transform: scale(1.06);
	}

	.project-hover-overlay {
		position: absolute;
		inset: 0;
		background: rgba(26, 58, 42, 0.75);
		display: flex;
		align-items: center;
		justify-content: center;
		opacity: 0;
		transition: opacity 0.35s ease;
		backdrop-filter: blur(3px);
	}

	.project-card:hover .project-hover-overlay {
		opacity: 1;
	}

	.project-view-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-body, "Jost", sans-serif);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: white;
		border: 1.5px solid rgba(255,255,255,0.5);
		padding: 0.6rem 1.25rem;
		border-radius: 999px;
		transition: border-color 0.2s ease;
	}

	.project-card:hover .project-view-btn {
		border-color: rgba(255,255,255,0.8);
	}

	.project-info {
		padding: 1.5rem 1.75rem;
	}

	.project-meta {
		font-family: var(--font-body, "Jost", sans-serif);
		font-size: 0.7rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-accent, #c4704b);
		margin-bottom: 0.4rem;
	}

	.project-info h3 {
		font-family: var(--font-display, "Cormorant Garamond", serif);
		font-size: 1.4rem;
		font-weight: 400;
		color: var(--color-primary, #1a3a2a);
		letter-spacing: -0.01em;
		line-height: 1.2;
	}

	.project-summary {
		font-family: var(--font-body, "Jost", sans-serif);
		font-size: 0.875rem;
		color: var(--color-muted, #7a8c72);
		line-height: 1.65;
		margin-top: 0.5rem;
	}
</style>
