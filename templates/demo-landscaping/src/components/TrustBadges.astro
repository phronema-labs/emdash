<section class="trust-ribbon">
	<div class="trust-inner">
		<div class="trust-item">
			<svg class="trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L3 7v6c0 5.25 3.75 10.15 9 11.25C17.25 23.15 21 18.25 21 13V7l-9-5z"/><path d="M9 12l2 2 4-4" stroke-linecap="round" stroke-linejoin="round"/></svg>
			<div class="trust-text"><strong>Licensed & Insured</strong><span>$2M Coverage</span></div>
		</div>
		<div class="trust-item">
			<svg class="trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
			<div class="trust-text"><strong>4.9 Google Rating</strong><span>500+ Reviews</span></div>
		</div>
		<div class="trust-item">
			<svg class="trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22c-4-3-8-7.5-8-12a8 8 0 0116 0c0 4.5-4 9-8 12z"/><circle cx="12" cy="10" r="3"/></svg>
			<div class="trust-text"><strong>Native Plant Experts</strong><span>Texas Climate</span></div>
		</div>
		<div class="trust-item">
			<svg class="trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>
			<div class="trust-text"><strong>Satisfaction Guarantee</strong><span>Or Your Money Back</span></div>
		</div>
		<div class="trust-item">
			<svg class="trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18"/><path d="M8 15h2"/></svg>
			<div class="trust-text"><strong>BBB Accredited</strong><span>A+ Rating</span></div>
		</div>
	</div>
</section>

<style>
	.trust-ribbon {
		background: var(--color-primary, #1a3a2a);
		padding: 1.5rem var(--site-gutter);
	}

	.trust-inner {
		max-width: var(--site-max-width);
		margin: 0 auto;
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.5rem 2.5rem;
	}

	.trust-item {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.4rem 0;
	}

	.trust-icon {
		width: 20px;
		height: 20px;
		color: var(--color-sage, #8fae7e);
		flex-shrink: 0;
	}

	.trust-text {
		display: flex;
		flex-direction: column;
	}

	.trust-text strong {
		font-family: var(--font-body, "Jost", sans-serif);
		font-size: 0.8rem;
		font-weight: 500;
		letter-spacing: 0.02em;
		color: rgba(255,255,255,0.85);
	}

	.trust-text span {
		font-family: var(--font-body, "Jost", sans-serif);
		font-size: 0.7rem;
		color: rgba(255,255,255,0.4);
		letter-spacing: 0.02em;
	}

	@media (max-width: 768px) {
		.trust-text span {
			display: none;
		}
	}

	@media (max-width: 480px) {
		.trust-inner {
			gap: 0.5rem 1.5rem;
		}
	}
</style>
