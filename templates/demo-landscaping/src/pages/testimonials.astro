---
import { getEmDashCollection } from "emdash";
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import GoogleReviews from "../components/GoogleReviews.astro";

const { entries: testimonials, cacheHint } = await getEmDashCollection("testimonials", { status: "published" });
if (cacheHint) Astro.response.headers.set("Cache-Control", cacheHint);

const hardcodedTestimonials = [
	{
		quote: "Marcus and his team transformed a sun-baked, clay-heavy lot into something I never thought was possible in Austin — a genuine garden. They listened carefully, proposed plants I'd never heard of, and delivered everything on time and within budget. Two years later, it still looks better every spring.",
		author: "Claire Donnelly",
		location: "Tarrytown",
		rating: 5,
		project: "Residential Garden Design, 2023",
	},
	{
		quote: "The irrigation design they specified has made a real difference to our water bills. We were skeptical that a drip system with smart controls could handle our property, but our summer water use dropped significantly after they installed it. The team was professional throughout.",
		author: "Roberto and Angela Fuentes",
		location: "Westlake Hills",
		rating: 5,
		project: "Irrigation and Planting, 2024",
	},
	{
		quote: "We hired Greenfield for a stone patio and terraced garden on a sloped backyard that three other contractors had turned down. They saw it as an opportunity rather than a problem. The result is the most used part of our house.",
		author: "James Whitfield",
		location: "South Congress",
		rating: 5,
		project: "Hardscape and Landscape, 2022",
	},
	{
		quote: "Priya's plant knowledge is extraordinary. She walked me through our existing garden, identified what was struggling and why, and proposed a replanting strategy that worked with the soil we already had rather than stripping everything out. It felt respectful of what was there.",
		author: "Helen Adeyemi",
		location: "Hyde Park",
		rating: 5,
		project: "Garden Consultation and Replanting, 2023",
	},
	{
		quote: "We've been on their maintenance plan for eighteen months now. The crew arrives when they say they will, they know the garden, and they leave a written note describing what they did and what to watch for. That level of communication is rare.",
		author: "Thomas and Sarah Brinkley",
		location: "Barton Hills",
		rating: 5,
		project: "Ongoing Maintenance Plan",
	},
	{
		quote: "I was nervous about investing in a full landscape design for a rental property, but the numbers have worked out. The curb appeal is night and day, the tenant retention improved, and the low-water plants mean the landscaping costs stay predictable.",
		author: "Miriam Shapiro",
		location: "East Austin",
		rating: 5,
		project: "Front Yard Landscape Design, 2023",
	},
	{
		quote: "What set Greenfield apart was the site visit. Marcus spent ninety minutes walking the property before he suggested a single plant. By the end I felt like he understood the place better than I did after living there for six years.",
		author: "Chris Nakamura",
		location: "Bouldin Creek",
		rating: 5,
		project: "Full Property Redesign, 2024",
	},
	{
		quote: "Daniel's project management made a complicated installation feel completely manageable. He gave us a clear schedule at the start, kept to it, and communicated any changes immediately. The crew left the site cleaner than they found it every day.",
		author: "Laura and Ben Castillo",
		location: "Mueller",
		rating: 5,
		project: "Native Meadow Installation, 2023",
	},
];

const displayTestimonials = testimonials.length > 0 ? testimonials : null;
---

<Base title="Testimonials" description="What clients say about working with Greenfield Landscaping — honest words from Austin homeowners and their gardens.">
	<PageHero
		title="Kind words from clients"
		subtitle="We're grateful for every garden we've been trusted to design and tend. Here's what some of those clients have to say."
		image="https://images.unsplash.com/photo-1598300042247-d088f8ab3a91?w=1600&h=600&fit=crop"
	/>

	{/* ===== Rating bar ===== */}
	<section class="rating-bar">
		<div class="container rating-bar-inner">
			<div class="rating-bar-left fade-in">
				<GoogleReviews rating={4.8} reviewCount={340} style="badge" />
			</div>
			<div class="rating-bar-right fade-in fade-in-delay-1">
				<p>Rated 4.8 stars across 340+ Google reviews. Every one of those projects began with a site visit and a conversation.</p>
			</div>
		</div>
	</section>

	{/* ===== Featured testimonial ===== */}
	{(displayTestimonials ? testimonials : hardcodedTestimonials).length > 0 && (
		<section class="featured-testimonial-section">
			<div class="container">
				{displayTestimonials ? (
					<div class="featured-quote fade-in">
						<div class="featured-quote-mark" aria-hidden="true">"</div>
						<blockquote class="featured-quote-text">{testimonials[0].data.quote}</blockquote>
						<div class="featured-quote-author">
							<div class="featured-author-stars" aria-label={`${testimonials[0].data.rating} out of 5 stars`}>
								{Array.from({ length: 5 }).map((_, i) => (
									<i class={`ph ${i < (testimonials[0].data.rating as number ?? 5) ? "ph-star-fill" : "ph-star"}`}></i>
								))}
							</div>
							<strong>{testimonials[0].data.author}</strong>
							{(testimonials[0].data.role || testimonials[0].data.company) && (
								<span>
									{testimonials[0].data.role}
									{testimonials[0].data.role && testimonials[0].data.company && " · "}
									{testimonials[0].data.company}
								</span>
							)}
						</div>
					</div>
				) : (
					<div class="featured-quote fade-in">
						<div class="featured-quote-mark" aria-hidden="true">"</div>
						<blockquote class="featured-quote-text">{hardcodedTestimonials[0]!.quote}</blockquote>
						<div class="featured-quote-author">
							<div class="featured-author-stars" aria-label="5 out of 5 stars">
								<i class="ph ph-star-fill"></i>
								<i class="ph ph-star-fill"></i>
								<i class="ph ph-star-fill"></i>
								<i class="ph ph-star-fill"></i>
								<i class="ph ph-star-fill"></i>
							</div>
							<strong>{hardcodedTestimonials[0]!.author}</strong>
							<span>{hardcodedTestimonials[0]!.location} · {hardcodedTestimonials[0]!.project}</span>
						</div>
					</div>
				)}
			</div>
		</section>
	)}

	{/* ===== Grid of testimonials ===== */}
	<section class="testimonials-grid-section">
		<div class="container">
			{displayTestimonials ? (
				<div class="testimonials-masonry">
					{testimonials.slice(1).map((t, i) => (
						<div class={`testimonial-card fade-in fade-in-delay-${Math.min((i % 3) + 1, 3)}`}>
							{t.data.rating && (
								<div class="card-stars" aria-label={`${t.data.rating} out of 5 stars`}>
									{Array.from({ length: 5 }).map((_, j) => (
										<i class={`ph ${j < (t.data.rating as number) ? "ph-star-fill" : "ph-star"}`}></i>
									))}
								</div>
							)}
							<blockquote class="card-quote">"{t.data.quote}"</blockquote>
							<footer class="card-footer">
								<strong class="card-author">{t.data.author}</strong>
								{(t.data.role || t.data.company) && (
									<span class="card-meta">
										{t.data.role}
										{t.data.role && t.data.company && " · "}
										{t.data.company}
									</span>
								)}
							</footer>
						</div>
					))}
				</div>
			) : (
				<div class="testimonials-masonry">
					{hardcodedTestimonials.slice(1).map((t, i) => (
						<div class={`testimonial-card fade-in fade-in-delay-${Math.min((i % 3) + 1, 3)}`}>
							<div class="card-stars" aria-label="5 out of 5 stars">
								<i class="ph ph-star-fill"></i>
								<i class="ph ph-star-fill"></i>
								<i class="ph ph-star-fill"></i>
								<i class="ph ph-star-fill"></i>
								<i class="ph ph-star-fill"></i>
							</div>
							<blockquote class="card-quote">"{t.quote}"</blockquote>
							<footer class="card-footer">
								<strong class="card-author">{t.author}</strong>
								<span class="card-meta">{t.location} · {t.project}</span>
							</footer>
						</div>
					))}
				</div>
			)}
		</div>
	</section>

	{/* ===== Divider image ===== */}
	<section class="divider-image-section">
		<div class="divider-img-wrap">
			<img
				src="https://images.unsplash.com/photo-1416879595882-3373a0480b5b?w=1600&h=400&fit=crop&crop=center"
				alt="Flourishing native garden"
				loading="lazy"
			/>
			<div class="divider-img-overlay">
				<div class="container">
					<blockquote class="divider-quote fade-in">
						"Every great garden begins with someone who believed it was possible."
					</blockquote>
				</div>
			</div>
		</div>
	</section>

	{/* ===== CTA ===== */}
	<section class="testimonials-cta">
		<div class="container testimonials-cta-inner fade-in">
			<span class="eyebrow">Your Turn</span>
			<h2>Ready to start your garden story?</h2>
			<p>Join the 2,500 families across Austin and the Hill Country who've trusted us to design and tend their outdoor spaces. Your first consultation is complimentary.</p>
			<div class="testimonials-cta-actions">
				<a href="/contact" class="btn btn-primary btn-lg">Begin Your Garden</a>
				<a href="/work" class="btn btn-secondary btn-lg">See Our Work</a>
			</div>
		</div>
	</section>
</Base>

<style>
	.eyebrow {
		display: inline-block;
		font-family: var(--font-body);
		font-size: 0.7rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: var(--color-accent);
		margin-bottom: 1rem;
	}

	/* ===== Rating bar ===== */
	.rating-bar {
		background: var(--color-surface);
		border-bottom: 1px solid var(--color-border-light);
		padding: 2rem 0;
	}

	.rating-bar-inner {
		display: flex;
		align-items: center;
		gap: 3rem;
		flex-wrap: wrap;
	}

	.rating-bar-right p {
		font-size: 0.9375rem;
		color: var(--color-text-light);
		line-height: 1.7;
		max-width: 480px;
	}

	/* ===== Featured testimonial ===== */
	.featured-testimonial-section {
		padding: var(--space-5xl) 0 var(--space-4xl);
	}

	.featured-quote {
		max-width: 840px;
		margin: 0 auto;
		position: relative;
		text-align: center;
		padding: 0 2rem;
	}

	.featured-quote-mark {
		font-family: var(--font-display);
		font-size: 8rem;
		line-height: 0.7;
		color: var(--color-sage-light);
		margin-bottom: 1.5rem;
		font-weight: 300;
		display: block;
	}

	.featured-quote-text {
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 2.5vw, 1.85rem);
		font-weight: 300;
		font-style: italic;
		color: var(--color-primary);
		line-height: 1.55;
		letter-spacing: -0.01em;
	}

	.featured-quote-author {
		margin-top: 2.5rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.4rem;
	}

	.featured-author-stars {
		display: flex;
		gap: 3px;
		color: #d97706;
		font-size: 16px;
		margin-bottom: 0.4rem;
	}

	.featured-quote-author strong {
		font-family: var(--font-display);
		font-size: 1.1rem;
		color: var(--color-primary);
		font-weight: 400;
	}

	.featured-quote-author span {
		font-family: var(--font-body);
		font-size: 0.8rem;
		color: var(--color-muted);
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}

	/* ===== Grid ===== */
	.testimonials-grid-section {
		background: var(--color-surface);
		padding: var(--space-5xl) 0;
	}

	.testimonials-masonry {
		columns: 3;
		column-gap: 1.75rem;
	}

	.testimonial-card {
		break-inside: avoid;
		margin-bottom: 1.75rem;
		background: var(--color-bg);
		border-radius: var(--radius-lg);
		padding: 2rem;
		border: 1px solid var(--color-border-light);
		display: flex;
		flex-direction: column;
		gap: 1rem;
		transition: transform var(--ease-base), box-shadow var(--ease-base);
	}

	.testimonial-card:hover {
		transform: translateY(-4px);
		box-shadow: var(--shadow-lg);
	}

	.card-stars {
		display: flex;
		gap: 2px;
		color: #d97706;
		font-size: 14px;
	}

	.card-quote {
		font-family: var(--font-display);
		font-size: 1.0625rem;
		font-style: italic;
		color: var(--color-text);
		line-height: 1.65;
		font-weight: 400;
	}

	.card-footer {
		padding-top: 0.75rem;
		border-top: 1px solid var(--color-border-light);
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}

	.card-author {
		font-family: var(--font-display);
		font-size: 1rem;
		color: var(--color-primary);
		font-weight: 400;
	}

	.card-meta {
		font-family: var(--font-body);
		font-size: 0.75rem;
		color: var(--color-muted);
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}

	/* ===== Divider image ===== */
	.divider-image-section {
		position: relative;
	}

	.divider-img-wrap {
		position: relative;
		overflow: hidden;
		height: 320px;
	}

	.divider-img-wrap img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 40%;
	}

	.divider-img-overlay {
		position: absolute;
		inset: 0;
		background: rgba(15, 35, 24, 0.7);
		display: flex;
		align-items: center;
	}

	.divider-quote {
		font-family: var(--font-display);
		font-size: clamp(1.3rem, 2.5vw, 1.85rem);
		font-weight: 300;
		font-style: italic;
		color: rgba(255,255,255,0.88);
		line-height: 1.5;
		max-width: 640px;
	}

	/* ===== CTA ===== */
	.testimonials-cta {
		padding: var(--space-5xl) 0;
	}

	.testimonials-cta-inner {
		text-align: center;
		max-width: 640px;
	}

	.testimonials-cta-inner h2 {
		color: var(--color-primary);
		font-size: clamp(1.8rem, 3.5vw, 3rem);
		margin-bottom: 1.25rem;
	}

	.testimonials-cta-inner p {
		font-size: 1rem;
		color: var(--color-text-light);
		line-height: 1.8;
		margin-bottom: 2.5rem;
	}

	.testimonials-cta-actions {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1.25rem;
		flex-wrap: wrap;
	}

	/* ===== Responsive ===== */
	@media (max-width: 900px) {
		.testimonials-masonry {
			columns: 2;
		}
	}

	@media (max-width: 600px) {
		.testimonials-masonry {
			columns: 1;
		}

		.rating-bar-inner {
			flex-direction: column;
			align-items: flex-start;
			gap: 1.25rem;
		}
	}
</style>
