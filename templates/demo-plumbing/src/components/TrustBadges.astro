---
interface Props {
	badges?: Array<{
		icon: string;
		label: string;
		sublabel?: string;
	}>;
}

const { badges = [
	{ icon: "ph-shield-check", label: "Licensed & Insured", sublabel: "$2M Coverage" },
	{ icon: "google", label: "4.9 Google Rating", sublabel: "500+ Reviews" },
	{ icon: "ph-clock", label: "Same-Day Service", sublabel: "Call Before Noon" },
	{ icon: "ph-seal-check", label: "Satisfaction Guarantee", sublabel: "Or Your Money Back" },
	{ icon: "ph-certificate", label: "BBB Accredited", sublabel: "A+ Rating" },
] } = Astro.props;
---

<section class="trust-badges">
	<div class="container">
		<div class="badges-strip">
			{badges.map((badge) => (
				<div class="badge">
					<div class="badge-icon">
						{badge.icon === "google" ? (
							<svg viewBox="0 0 24 24" width="18" height="18">
								<path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/>
								<path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
								<path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
								<path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
							</svg>
						) : (
							<i class={`ph ${badge.icon}`} />
						)}
					</div>
					<div class="badge-text">
						<strong>{badge.label}</strong>
						{badge.sublabel && <span>{badge.sublabel}</span>}
					</div>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.trust-badges {
		background: var(--color-primary);
		padding: var(--space-lg) var(--site-gutter);
	}

	.badges-strip {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: var(--spacing-xl) var(--spacing-3xl);
	}

	.badge {
		display: flex;
		align-items: center;
		gap: var(--spacing-sm);
	}

	.badge-icon {
		width: 34px;
		height: 34px;
		border-radius: var(--radius-sm);
		background: rgba(255, 255, 255, 0.12);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 18px;
		color: white;
		flex-shrink: 0;
	}

	.badge-text {
		display: flex;
		flex-direction: column;
		gap: 1px;
	}

	.badge-text strong {
		font-family: var(--font-headline, 'Outfit', sans-serif);
		font-size: var(--font-size-sm);
		font-weight: 700;
		color: white;
		white-space: nowrap;
	}

	.badge-text span {
		font-size: var(--font-size-xs);
		color: rgba(255, 255, 255, 0.65);
		white-space: nowrap;
	}

	@media (max-width: 768px) {
		.badges-strip {
			gap: var(--spacing-lg) var(--spacing-xl);
		}

		.badge-text span {
			display: none;
		}
	}
</style>
