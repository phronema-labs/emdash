---
interface Props {
	badges?: Array<{
		icon: string;
		label: string;
		sublabel?: string;
	}>;
}

const { badges = [
	{ icon: "ph-shield-check", label: "Licensed & Insured", sublabel: "$2M Coverage" },
	{ icon: "ph-star-fill", label: "4.9 Google Rating", sublabel: "500+ Reviews" },
	{ icon: "ph-clock", label: "Same-Day Service", sublabel: "Call Before Noon" },
	{ icon: "ph-seal-check", label: "Satisfaction Guarantee", sublabel: "Or Your Money Back" },
	{ icon: "ph-certificate", label: "BBB Accredited", sublabel: "A+ Rating" },
] } = Astro.props;
---

<section class="trust-badges">
	<div class="container">
		<div class="badges-strip">
			{badges.map((badge) => (
				<div class="badge">
					<div class="badge-icon">
						<i class={`ph ${badge.icon}`} />
					</div>
					<div class="badge-text">
						<strong>{badge.label}</strong>
						{badge.sublabel && <span>{badge.sublabel}</span>}
					</div>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.trust-badges {
		background: var(--color-primary);
		padding: var(--space-lg) var(--site-gutter);
	}

	.badges-strip {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: var(--spacing-xl) var(--spacing-3xl);
	}

	.badge {
		display: flex;
		align-items: center;
		gap: var(--spacing-sm);
	}

	.badge-icon {
		width: 34px;
		height: 34px;
		border-radius: var(--radius-sm);
		background: rgba(255, 255, 255, 0.12);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 18px;
		color: white;
		flex-shrink: 0;
	}

	.badge-text {
		display: flex;
		flex-direction: column;
		gap: 1px;
	}

	.badge-text strong {
		font-family: var(--font-headline, 'Outfit', sans-serif);
		font-size: var(--font-size-sm);
		font-weight: 700;
		color: white;
		white-space: nowrap;
	}

	.badge-text span {
		font-size: var(--font-size-xs);
		color: rgba(255, 255, 255, 0.65);
		white-space: nowrap;
	}

	@media (max-width: 768px) {
		.badges-strip {
			gap: var(--spacing-lg) var(--spacing-xl);
		}

		.badge-text span {
			display: none;
		}
	}
</style>
