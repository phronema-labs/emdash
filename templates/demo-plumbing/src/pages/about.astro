---
import { getEmDashCollection } from "emdash";
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";

const { entries: teamMembers } = await getEmDashCollection("team", { status: "published" });

const hardcodedTeam = [
	{
		name: "Mike Harrington",
		role: "Owner & Master Plumber",
		license: "IL Master Plumber #MP-04821",
		bio: "Mike founded Summit in 2009 after 12 years working for regional contractors. He holds master licenses in both plumbing and HVAC and personally oversees quality on every large job.",
		photo: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=200&h=200&fit=crop&crop=face",
		since: "Since 2009",
	},
	{
		name: "Carla Vasquez",
		role: "Lead HVAC Technician",
		license: "EPA 608 Certified · NATE Certified",
		bio: "Carla leads our HVAC division with 11 years of field experience. She specializes in high-efficiency system installations and complex diagnostic work.",
		photo: "https://images.unsplash.com/photo-1494790108755-2616b612b47c?w=200&h=200&fit=crop&crop=face",
		since: "Since 2014",
	},
	{
		name: "James Kowalski",
		role: "Senior Electrician",
		license: "IL Licensed Electrician #E-11294",
		bio: "James has wired everything from new construction to full panel upgrades for historic homes. He's known for clean work and meticulous code compliance.",
		photo: "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=200&h=200&fit=crop&crop=face",
		since: "Since 2017",
	},
];

const displayTeam = teamMembers.length > 0
	? teamMembers.map((m) => ({
		name: m.data.name,
		role: m.data.role || "",
		license: "",
		bio: typeof m.data.bio === "string" ? m.data.bio : "",
		photo: typeof m.data.photo === "string" ? m.data.photo : (m.data.photo as any)?.url || "",
		since: "",
	}))
	: hardcodedTeam;
---

<Base title="About Us" description="Family-owned plumbing, HVAC, and electrical serving Springfield, IL since 2009. Licensed, insured, and satisfaction guaranteed.">
	<PageHero
		title="About Summit Home Services"
		subtitle="Family-owned, Springfield-based, serving homeowners since 2009."
		image="https://images.unsplash.com/photo-1621905251189-08b45d6a269e?w=1600&h=500&fit=crop"
	/>

	{/* ===== Phone bar ===== */}
	<div class="phone-bar">
		<div class="container phone-bar-inner">
			<div class="phone-bar-left">
				<span class="avail-dot-wrap">
					<span class="avail-dot"></span>
				</span>
				<span class="phone-bar-label">Available now — 24/7 for emergencies</span>
			</div>
			<a href="tel:5552345678" class="phone-bar-number">(555) 234-5678</a>
		</div>
	</div>

	{/* ===== Story section ===== */}
	<section class="section">
		<div class="container story-grid">
			<div class="story-text">
				<span class="section-label">Our Story</span>
				<h2>Built on trust. Backed by experience.</h2>
				<p>
					Summit Home Services started in Mike Harrington's garage in 2009 with one truck, one apprentice, and a simple rule: show up on time, do the job right, and charge a fair price.
				</p>
				<p>
					Fifteen years later we're a team of 14 licensed technicians covering all of Sangamon County. We still run on the same principles. We still answer our own phone. And we still back every job with a written guarantee.
				</p>
				<p>
					We're not the biggest contractor in Springfield. We don't want to be. We want to be the one you call every time, and the one you recommend to your neighbors without hesitation.
				</p>
				<div class="story-stats">
					<div class="story-stat">
						<span class="story-stat-num">15+</span>
						<span class="story-stat-label">Years in business</span>
					</div>
					<div class="story-stat">
						<span class="story-stat-num">10K+</span>
						<span class="story-stat-label">Jobs completed</span>
					</div>
					<div class="story-stat">
						<span class="story-stat-num">4.9</span>
						<span class="story-stat-label">Google rating</span>
					</div>
				</div>
			</div>
			<div class="story-image">
				<img
					src="https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=600&h=750&fit=crop"
					alt="Summit technician on the job"
					loading="lazy"
				/>
				<div class="story-image-badge">
					<i class="ph ph-certificate" />
					<div>
						<strong>Serving Springfield since 2009</strong>
						<span>Sangamon County &amp; surrounding areas</span>
					</div>
				</div>
			</div>
		</div>
	</section>

	{/* ===== Trust signals ===== */}
	<section class="section trust-section">
		<div class="container">
			<div class="trust-header">
				<span class="section-label">Credentials &amp; Guarantees</span>
				<h2>Why homeowners trust Summit</h2>
			</div>
			<div class="trust-grid">
				<div class="trust-card">
					<div class="trust-icon">
						<i class="ph ph-shield-check" />
					</div>
					<h3>Licensed &amp; Insured</h3>
					<p>All technicians hold current state licenses. We carry $2M general liability and full workers' comp — protecting you and your home on every job.</p>
					<ul class="trust-list">
						<li><i class="ph ph-check" /> IL Master Plumber License</li>
						<li><i class="ph ph-check" /> IL Electrical License</li>
						<li><i class="ph ph-check" /> EPA 608 Certified HVAC</li>
						<li><i class="ph ph-check" /> NATE Certified Technicians</li>
					</ul>
				</div>
				<div class="trust-card">
					<div class="trust-icon">
						<i class="ph ph-seal-check" />
					</div>
					<h3>1-Year Labor Warranty</h3>
					<p>Every repair and installation comes with a minimum 1-year labor warranty. If something we fixed stops working, we come back and fix it free. No debate, no invoice.</p>
					<ul class="trust-list">
						<li><i class="ph ph-check" /> Written warranty on all work</li>
						<li><i class="ph ph-check" /> Manufacturer warranties honored</li>
						<li><i class="ph ph-check" /> No-hassle callback policy</li>
						<li><i class="ph ph-check" /> 100% satisfaction guarantee</li>
					</ul>
				</div>
				<div class="trust-card">
					<div class="trust-icon">
						<i class="ph ph-currency-dollar" />
					</div>
					<h3>Upfront Flat-Rate Pricing</h3>
					<p>You'll know the exact price before we start. No hourly billing surprises. No add-ons after the fact. Our flat-rate pricing means the quote we give is the price you pay.</p>
					<ul class="trust-list">
						<li><i class="ph ph-check" /> Free written estimates</li>
						<li><i class="ph ph-check" /> No hidden fees ever</li>
						<li><i class="ph ph-check" /> Financing available</li>
						<li><i class="ph ph-check" /> Senior &amp; military discounts</li>
					</ul>
				</div>
				<div class="trust-card">
					<div class="trust-icon">
						<i class="ph ph-clock" />
					</div>
					<h3>Same-Day &amp; Emergency</h3>
					<p>Call before noon and we'll be there same day, guaranteed. For true emergencies — burst pipes, no heat in winter, electrical hazards — we're available 24 hours a day.</p>
					<ul class="trust-list">
						<li><i class="ph ph-check" /> Same-day if called by noon</li>
						<li><i class="ph ph-check" /> 24/7 emergency line</li>
						<li><i class="ph ph-check" /> 60-minute emergency response</li>
						<li><i class="ph ph-check" /> No after-hours surcharge on most jobs</li>
					</ul>
				</div>
			</div>
		</div>
	</section>

	{/* ===== Team ===== */}
	<section class="section" style="background: var(--color-surface);">
		<div class="container">
			<div class="team-header">
				<span class="section-label">The Team</span>
				<h2>Meet our technicians</h2>
				<p>Every Summit technician is licensed, background-checked, and trained in our own shop before they enter your home.</p>
			</div>
			<div class="team-grid">
				{displayTeam.map((member) => (
					<div class="team-card">
						{member.photo && (
							<img src={member.photo} alt={member.name} class="team-photo" loading="lazy" />
						)}
						<div class="team-body">
							<h3>{member.name}</h3>
							{member.role && <p class="team-role">{member.role}</p>}
							{member.license && <p class="team-license"><i class="ph ph-certificate" /> {member.license}</p>}
							{member.bio && <p class="team-bio">{member.bio}</p>}
							{member.since && <p class="team-since"><i class="ph ph-calendar-blank" /> {member.since}</p>}
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	{/* ===== Service area ===== */}
	<section class="section">
		<div class="container area-section">
			<div class="area-text">
				<span class="section-label">Service Area</span>
				<h2>Serving Springfield and Sangamon County</h2>
				<p>We cover all of Sangamon County including Springfield, Chatham, Sherman, Rochester, Riverton, Williamsville, and surrounding communities. Not sure if we come to you? Call us — if we can't help, we'll refer you to someone who can.</p>
				<div class="area-cities">
					{["Springfield", "Chatham", "Sherman", "Rochester", "Riverton", "Williamsville", "Auburn", "Pawnee", "Kincaid", "Virden"].map((city) => (
						<span class="area-city"><i class="ph ph-map-pin" /> {city}</span>
					))}
				</div>
				<a href="/contact" class="btn btn-primary btn-lg" style="margin-top: var(--spacing-xl);">
					<i class="ph ph-calendar-check" /> Schedule Service
				</a>
			</div>
			<div class="area-cta-card">
				<h3>Not sure we cover your area?</h3>
				<p>Call us and we'll give you a straight answer.</p>
				<a href="tel:5552345678" class="area-phone">(555) 234-5678</a>
				<span class="area-avail">
					<span class="avail-dot"></span>
					Available now
				</span>
			</div>
		</div>
	</section>

	{/* ===== Emergency CTA ===== */}
	<section class="emergency-cta">
		<div class="container emergency-inner">
			<div class="emergency-left">
				<div class="emergency-pulse">
					<span class="emergency-dot"></span>
				</div>
				<div>
					<h2>Need service today?</h2>
					<p>Same-day and 24/7 emergency service available. We answer every call.</p>
				</div>
			</div>
			<div class="emergency-right">
				<a href="tel:5552345678" class="emergency-phone-btn">
					<i class="ph ph-phone-call" />
					(555) 234-5678
				</a>
				<a href="/contact" class="btn btn-outline-em">Schedule Online</a>
			</div>
		</div>
	</section>
</Base>

<style>
	/* ===== Phone bar ===== */
	.phone-bar {
		background: var(--color-primary);
		padding: var(--spacing-sm) 0;
	}

	.phone-bar-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-lg);
		flex-wrap: wrap;
	}

	.phone-bar-left {
		display: flex;
		align-items: center;
		gap: var(--spacing-sm);
	}

	.phone-bar-label {
		font-family: var(--font-headline);
		font-size: var(--font-size-sm);
		font-weight: 600;
		color: rgba(255,255,255,0.85);
	}

	.avail-dot-wrap {
		display: flex;
		align-items: center;
	}

	.avail-dot {
		display: block;
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #4ade80;
		animation: pulse-ring 2s infinite;
		flex-shrink: 0;
	}

	.phone-bar-number {
		font-family: var(--font-headline);
		font-size: var(--font-size-xl);
		font-weight: 900;
		color: white;
		letter-spacing: -0.02em;
		transition: color var(--transition-fast);
	}

	.phone-bar-number:hover {
		color: var(--color-accent);
	}

	/* ===== Section label ===== */
	.section-label {
		display: inline-block;
		font-family: var(--font-headline);
		font-size: var(--font-size-xs);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-primary);
		background: var(--color-primary-light);
		padding: 3px 10px;
		border-radius: var(--radius-sm);
		margin-bottom: var(--spacing-sm);
	}

	/* ===== Story ===== */
	.story-grid {
		display: grid;
		grid-template-columns: 1fr 380px;
		gap: var(--spacing-4xl);
		align-items: start;
	}

	.story-text h2 {
		font-size: var(--font-size-3xl);
		font-weight: 800;
		margin-bottom: var(--spacing-xl);
		letter-spacing: -0.03em;
	}

	.story-text p {
		color: var(--color-muted);
		line-height: 1.75;
		margin-bottom: var(--spacing-lg);
	}

	.story-stats {
		display: flex;
		gap: var(--spacing-2xl);
		padding-top: var(--spacing-xl);
		border-top: 1.5px solid var(--color-border);
		margin-top: var(--spacing-xl);
	}

	.story-stat {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.story-stat-num {
		font-family: var(--font-headline);
		font-size: var(--font-size-3xl);
		font-weight: 900;
		color: var(--color-primary);
		letter-spacing: -0.03em;
		line-height: 1;
	}

	.story-stat-label {
		font-family: var(--font-headline);
		font-size: var(--font-size-xs);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.07em;
		color: var(--color-muted);
	}

	.story-image {
		position: relative;
	}

	.story-image img {
		width: 100%;
		border-radius: var(--radius-lg);
		border: 1.5px solid var(--color-border);
	}

	.story-image-badge {
		position: absolute;
		bottom: var(--spacing-lg);
		left: var(--spacing-lg);
		right: var(--spacing-lg);
		background: white;
		border: 1.5px solid var(--color-border);
		border-radius: var(--radius);
		padding: var(--spacing-md) var(--spacing-lg);
		display: flex;
		align-items: center;
		gap: var(--spacing-md);
		box-shadow: var(--shadow-lg);
	}

	.story-image-badge i {
		font-size: 24px;
		color: var(--color-primary);
		flex-shrink: 0;
	}

	.story-image-badge strong {
		display: block;
		font-family: var(--font-headline);
		font-size: var(--font-size-sm);
		font-weight: 700;
	}

	.story-image-badge span {
		display: block;
		font-size: var(--font-size-xs);
		color: var(--color-muted);
	}

	/* ===== Trust ===== */
	.trust-section {
		background: var(--color-surface);
	}

	.trust-header {
		text-align: center;
		margin-bottom: var(--spacing-3xl);
	}

	.trust-header h2 {
		font-size: var(--font-size-3xl);
		font-weight: 800;
		letter-spacing: -0.03em;
	}

	.trust-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: var(--spacing-lg);
	}

	.trust-card {
		background: white;
		border: 1.5px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--spacing-xl);
		display: flex;
		flex-direction: column;
		gap: var(--spacing-md);
		transition: border-color var(--transition-base), box-shadow var(--transition-base);
	}

	.trust-card:hover {
		border-color: var(--color-primary);
		box-shadow: var(--shadow-lg);
	}

	.trust-icon {
		width: 48px;
		height: 48px;
		border-radius: var(--radius-md);
		background: var(--color-primary-light);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 24px;
		color: var(--color-primary);
	}

	.trust-card h3 {
		font-family: var(--font-headline);
		font-size: var(--font-size-base);
		font-weight: 700;
		line-height: 1.25;
	}

	.trust-card p {
		color: var(--color-muted);
		font-size: var(--font-size-sm);
		line-height: 1.6;
	}

	.trust-list {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 6px;
		margin-top: var(--spacing-sm);
		padding-top: var(--spacing-sm);
		border-top: 1px solid var(--color-border);
	}

	.trust-list li {
		display: flex;
		align-items: center;
		gap: 6px;
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.trust-list i {
		color: var(--color-primary);
		font-size: 13px;
		flex-shrink: 0;
	}

	/* ===== Team ===== */
	.team-header {
		text-align: center;
		margin-bottom: var(--spacing-3xl);
	}

	.team-header h2 {
		font-size: var(--font-size-3xl);
		font-weight: 800;
		letter-spacing: -0.03em;
	}

	.team-header p {
		color: var(--color-muted);
		max-width: 560px;
		margin-inline: auto;
		margin-top: var(--spacing-sm);
	}

	.team-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-xl);
	}

	.team-card {
		background: white;
		border: 1.5px solid var(--color-border);
		border-radius: var(--radius-lg);
		overflow: hidden;
		transition: border-color var(--transition-base), box-shadow var(--transition-base);
	}

	.team-card:hover {
		border-color: var(--color-primary);
		box-shadow: var(--shadow-lg);
	}

	.team-photo {
		width: 100%;
		aspect-ratio: 4/3;
		object-fit: cover;
		object-position: center top;
		display: block;
	}

	.team-body {
		padding: var(--spacing-xl);
		display: flex;
		flex-direction: column;
		gap: var(--spacing-xs);
	}

	.team-body h3 {
		font-family: var(--font-headline);
		font-size: var(--font-size-lg);
		font-weight: 700;
	}

	.team-role {
		color: var(--color-primary);
		font-family: var(--font-headline);
		font-size: var(--font-size-sm);
		font-weight: 600;
	}

	.team-license {
		display: flex;
		align-items: center;
		gap: 5px;
		font-size: var(--font-size-xs);
		color: var(--color-muted);
		font-family: var(--font-headline);
	}

	.team-license i {
		color: var(--color-accent);
		font-size: 12px;
	}

	.team-bio {
		color: var(--color-muted);
		font-size: var(--font-size-sm);
		line-height: 1.65;
		margin-top: var(--spacing-sm);
	}

	.team-since {
		display: flex;
		align-items: center;
		gap: 5px;
		font-size: var(--font-size-xs);
		font-family: var(--font-headline);
		font-weight: 600;
		color: var(--color-muted);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		margin-top: var(--spacing-sm);
		padding-top: var(--spacing-sm);
		border-top: 1px solid var(--color-border);
	}

	.team-since i {
		color: var(--color-primary);
	}

	/* ===== Service area ===== */
	.area-section {
		display: grid;
		grid-template-columns: 1fr 340px;
		gap: var(--spacing-4xl);
		align-items: start;
	}

	.area-text h2 {
		font-size: var(--font-size-3xl);
		font-weight: 800;
		letter-spacing: -0.03em;
		margin-bottom: var(--spacing-lg);
	}

	.area-text p {
		color: var(--color-muted);
		line-height: 1.75;
		max-width: 560px;
	}

	.area-cities {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-sm);
		margin-top: var(--spacing-xl);
	}

	.area-city {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		font-family: var(--font-headline);
		font-size: var(--font-size-sm);
		font-weight: 600;
		background: var(--color-surface);
		border: 1.5px solid var(--color-border);
		border-radius: var(--radius);
		padding: 4px 12px;
		color: var(--color-text);
	}

	.area-city i {
		color: var(--color-primary);
		font-size: 12px;
	}

	.area-cta-card {
		background: var(--color-primary);
		border-radius: var(--radius-lg);
		padding: var(--spacing-2xl);
		display: flex;
		flex-direction: column;
		gap: var(--spacing-md);
		color: white;
		position: sticky;
		top: 100px;
	}

	.area-cta-card h3 {
		font-family: var(--font-headline);
		font-size: var(--font-size-xl);
		font-weight: 800;
		color: white;
		line-height: 1.2;
	}

	.area-cta-card p {
		color: rgba(255,255,255,0.7);
		font-size: var(--font-size-sm);
	}

	.area-phone {
		font-family: var(--font-headline);
		font-size: var(--font-size-3xl);
		font-weight: 900;
		color: white;
		letter-spacing: -0.03em;
		line-height: 1;
		display: block;
		transition: color var(--transition-fast);
	}

	.area-phone:hover {
		color: var(--color-accent);
	}

	.area-avail {
		display: flex;
		align-items: center;
		gap: var(--spacing-sm);
		font-family: var(--font-headline);
		font-size: var(--font-size-xs);
		font-weight: 700;
		color: #4ade80;
		text-transform: uppercase;
		letter-spacing: 0.07em;
	}

	/* ===== Emergency CTA ===== */
	.emergency-cta {
		background: linear-gradient(135deg, var(--color-primary-dark) 0%, #0052cc 100%);
		padding: var(--spacing-3xl) var(--site-gutter);
		position: relative;
