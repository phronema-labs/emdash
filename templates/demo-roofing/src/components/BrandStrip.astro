---
const brands = [
	"GAF", "Owens Corning", "CertainTeed", "IKO", "TAMKO",
	"Atlas", "Malarkey", "Pabco", "Johns Manville", "BP"
];
---

<section class="brand-strip">
	<div class="container">
		<p class="brand-label">Certified installer for all major roofing manufacturers</p>
		<div class="brand-logos">
			{brands.map((brand) => (
				<span class="brand-name">{brand}</span>
			))}
		</div>
	</div>
</section>

<style>
	.brand-strip {
		background: #0f0f0f;
		padding: 2.5rem var(--site-gutter);
		border-bottom: 1px solid rgba(255, 255, 255, 0.05);
	}

	.brand-label {
		text-align: center;
		font-family: var(--font-headline);
		font-size: 0.7rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.18em;
		color: rgba(255, 255, 255, 0.3);
		margin-bottom: 1.5rem;
	}

	.brand-logos {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1rem 3rem;
	}

	.brand-name {
		font-family: var(--font-headline);
		font-size: 1.1rem;
		font-weight: 800;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.2);
		transition: color 200ms ease;
	}

	.brand-name:hover {
		color: rgba(255, 255, 255, 0.5);
	}

	@media (max-width: 600px) {
		.brand-logos { gap: 0.75rem 2rem; }
		.brand-name { font-size: 0.9rem; }
	}
</style>
