---
---

<section class="estimator" id="estimator">
	<div class="container">
		<header class="estimator-header">
			<span class="estimator-label">INSTANT PRICING</span>
			<h2>Get a Quick Estimate</h2>
			<p>Select your roof type and project scope for an instant ballpark price. For an exact quote, <a href="/contact">schedule a free inspection</a>.</p>
		</header>

		<div class="estimator-form" data-estimator>
			<div class="estimator-step">
				<label class="step-label">1. What type of project?</label>
				<div class="option-grid" data-field="service">
					<button class="option-btn" data-value="repair">
						<i class="ph ph-wrench"></i>
						<span>Roof Repair</span>
					</button>
					<button class="option-btn" data-value="replacement">
						<i class="ph ph-house"></i>
						<span>Full Replacement</span>
					</button>
					<button class="option-btn" data-value="storm">
						<i class="ph ph-cloud-rain"></i>
						<span>Storm Damage</span>
					</button>
				</div>
			</div>

			<div class="estimator-step">
				<label class="step-label">2. Roof material?</label>
				<div class="option-grid" data-field="type">
					<button class="option-btn" data-value="shingle">
						<i class="ph ph-stack"></i>
						<span>Asphalt Shingle</span>
					</button>
					<button class="option-btn" data-value="tile">
						<i class="ph ph-grid-four"></i>
						<span>Tile / Slate</span>
					</button>
					<button class="option-btn" data-value="metal">
						<i class="ph ph-rows"></i>
						<span>Metal Roof</span>
					</button>
				</div>
			</div>

			<div class="estimator-step">
				<label class="step-label">3. How urgent?</label>
				<div class="option-grid" data-field="urgency">
					<button class="option-btn" data-value="routine">
						<i class="ph ph-calendar"></i>
						<span>Planning Ahead</span>
					</button>
					<button class="option-btn" data-value="soon">
						<i class="ph ph-clock"></i>
						<span>Within 2 Weeks</span>
					</button>
					<button class="option-btn" data-value="emergency">
						<i class="ph ph-siren"></i>
						<span>Emergency Now</span>
					</button>
				</div>
			</div>

			<div class="estimator-result" data-result style="display: none;">
				<div class="result-card">
					<span class="result-label">Estimated Range</span>
					<span class="result-price" data-price></span>
					<span class="result-note">*Exact pricing after free on-site inspection. No obligation.</span>
					<a href="/contact" class="btn btn-primary btn-lg">Schedule Free Inspection</a>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	document.querySelectorAll<HTMLElement>("[data-estimator]").forEach((form) => {
		const state: Record<string, string> = {};
		const result = form.querySelector<HTMLElement>("[data-result]")!;
		const priceEl = form.querySelector<HTMLElement>("[data-price]")!;

		const PRICES: Record<string, Record<string, Record<string, string>>> = {
			repair: {
				shingle: { routine: "$350 – $1,200", soon: "$400 – $1,400", emergency: "$600 – $2,000" },
				tile: { routine: "$500 – $2,000", soon: "$600 – $2,400", emergency: "$800 – $3,200" },
				metal: { routine: "$400 – $1,800", soon: "$500 – $2,200", emergency: "$700 – $3,000" },
			},
			replacement: {
				shingle: { routine: "$6,000 – $15,000", soon: "$6,500 – $16,000", emergency: "$8,000 – $18,000" },
				tile: { routine: "$12,000 – $28,000", soon: "$13,000 – $30,000", emergency: "$16,000 – $35,000" },
				metal: { routine: "$10,000 – $25,000", soon: "$11,000 – $27,000", emergency: "$14,000 – $32,000" },
			},
			storm: {
				shingle: { routine: "$800 – $4,000", soon: "$1,000 – $5,000", emergency: "$500 – $3,500" },
				tile: { routine: "$1,200 – $6,000", soon: "$1,500 – $7,500", emergency: "$800 – $5,000" },
				metal: { routine: "$1,000 – $5,000", soon: "$1,200 – $6,500", emergency: "$700 – $4,500" },
			},
		};

		form.querySelectorAll<HTMLElement>(".option-btn").forEach((btn) => {
			btn.addEventListener("click", () => {
				const field = btn.closest("[data-field]")?.getAttribute("data-field");
				if (!field) return;

				btn.closest(".option-grid")?.querySelectorAll(".option-btn").forEach((b) => b.classList.remove("active"));
				btn.classList.add("active");
				state[field] = btn.dataset.value!;

				if (state.service && state.type && state.urgency) {
					const price = PRICES[state.service]?.[state.type]?.[state.urgency] ?? "Call for quote";
					priceEl.textContent = price;
					result.style.display = "block";
					result.scrollIntoView({ behavior: "smooth", block: "nearest" });
				}
			});
		});
	});
</script>

<style>
	.estimator {
		background: #111111;
		padding-block: var(--space-4xl);
		padding-inline: var(--site-gutter);
		position: relative;
		overflow: hidden;
	}

	.estimator::before {
		content: "";
		position: absolute;
		inset: 0;
		background: repeating-linear-gradient(
			-45deg,
			transparent,
			transparent 40px,
			rgba(255, 255, 255, 0.01) 40px,
			rgba(255, 255, 255, 0.01) 41px
		);
		pointer-events: none;
	}

	.estimator-header {
		text-align: center;
		margin-bottom: 3.5rem;
		position: relative;
	}

	.estimator-label {
		display: inline-block;
		font-family: var(--font-headline);
		font-size: 0.7rem;
		font-weight: 800;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--color-primary);
		margin-bottom: 1rem;
	}

	.estimator-header h2 {
		font-size: clamp(2.5rem, 4vw, 4rem);
		color: white;
		margin-bottom: 1rem;
	}

	.estimator-header p {
		font-family: var(--font-body);
		color: rgba(255, 255, 255, 0.45);
		font-size: 1rem;
		max-width: 520px;
		margin-inline: auto;
	}

	.estimator-header a {
		color: var(--color-primary);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.estimator-form {
		max-width: 720px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
		position: relative;
	}

	.step-label {
		display: block;
		font-family: var(--font-headline);
		font-weight: 800;
		font-size: 1.1rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.7);
		margin-bottom: 1rem;
	}

	.option-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
	}

	.option-btn {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.6rem;
		padding: 1.25rem 1rem;
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: var(--radius-md);
		cursor: pointer;
		font-family: var(--font-headline);
		font-size: 0.9rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.5);
		transition: all var(--transition-fast);
	}

	.option-btn i {
		font-size: 1.6rem;
		color: rgba(255, 255, 255, 0.25);
		transition: color var(--transition-fast);
	}

	.option-btn:hover {
		border-color: rgba(220, 38, 38, 0.4);
		background: rgba(220, 38, 38, 0.05);
		color: white;
	}

	.option-btn:hover i {
		color: var(--color-primary);
	}

	.option-btn.active {
		border-color: var(--color-primary);
		background: rgba(220, 38, 38, 0.12);
		color: white;
		box-shadow: 0 0 20px rgba(220, 38, 38, 0.15);
	}

	.option-btn.active i {
		color: var(--color-primary);
	}

	.result-card {
		text-align: center;
		padding: 2.5rem;
		background: rgba(220, 38, 38, 0.06);
		border: 1px solid rgba(220, 38, 38, 0.3);
		border-radius: var(--radius-md);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		animation: slideUp 0.4s cubic-bezier(0.4, 0, 0.2, 1);
		box-shadow: 0 0 60px rgba(220, 38, 38, 0.1);
	}

	@keyframes slideUp {
		from { opacity: 0; transform: translateY(16px); }
		to { opacity: 1; transform: translateY(0); }
	}

	.result-label {
		font-family: var(--font-headline);
		font-size: 0.75rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.18em;
		color: rgba(255, 255, 255, 0.4);
	}

	.result-price {
		font-family: var(--font-headline);
		font-size: clamp(2.5rem, 5vw, 4rem);
		font-weight: 900;
		color: white;
		letter-spacing: 0.02em;
		line-height: 1;
	}

	.result-note {
		font-family: var(--font-body);
		font-size: 0.8rem;
		color: rgba(255, 255, 255, 0.3);
		font-style: italic;
	}

	@media (max-width: 600px) {
		.option-grid { grid-template-columns: 1fr; }
		.option-btn {
			flex-direction: row;
			justify-content: center;
		}
	}
</style>
