---
interface Props {
	rating?: number;
	reviewCount?: number;
	style?: "badge" | "full";
}

const { rating = 4.9, reviewCount = 847, style = "badge" } = Astro.props;

const fullStars = Math.floor(rating);
const hasHalf = rating % 1 >= 0.3;
---

{style === "badge" ? (
	<div class="google-badge">
		<div class="google-icon">
			<svg viewBox="0 0 24 24" width="20" height="20">
				<path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/>
				<path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
				<path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
				<path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
			</svg>
		</div>
		<div class="google-info">
			<div class="google-stars">
				{Array.from({ length: 5 }).map((_, i) => (
					<i class={`ph ${i < fullStars ? "ph-star-fill" : (i === fullStars && hasHalf ? "ph-star-half" : "ph-star")}`} />
				))}
				<span class="google-rating">{rating}</span>
			</div>
			<span class="google-count">{reviewCount} Google Reviews</span>
		</div>
	</div>
) : (
	<div class="google-full">
		<div class="google-full-header">
			<svg viewBox="0 0 24 24" width="28" height="28">
				<path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/>
				<path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
				<path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
				<path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
			</svg>
			<div>
				<span class="google-full-rating">{rating}</span>
				<div class="google-stars-lg">
					{Array.from({ length: 5 }).map((_, i) => (
						<i class={`ph ${i < fullStars ? "ph-star-fill" : (i === fullStars && hasHalf ? "ph-star-half" : "ph-star")}`} />
					))}
				</div>
			</div>
		</div>
		<p class="google-full-count">Based on <strong>{reviewCount}</strong> reviews</p>
	</div>
)}

<style>
	/* Badge style */
	.google-badge {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		padding: 8px 14px;
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 6px;
	}

	.google-stars {
		display: flex;
		align-items: center;
		gap: 2px;
		color: #f59e0b;
		font-size: 14px;
	}

	.google-rating {
		font-family: var(--font-headline);
		font-weight: 900;
		color: white;
		font-size: 14px;
		margin-left: 4px;
	}

	.google-count {
		font-family: var(--font-body);
		font-size: 11px;
		color: rgba(255, 255, 255, 0.4);
	}

	.google-info {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	/* Full style */
	.google-full {
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 10px;
		padding: 1.5rem;
		text-align: center;
		display: inline-block;
	}

	.google-full-header {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 10px;
	}

	.google-full-rating {
		font-family: var(--font-headline);
		font-size: 2.5rem;
		font-weight: 900;
		color: white;
		line-height: 1;
	}

	.google-stars-lg {
		display: flex;
		gap: 2px;
		color: #f59e0b;
		font-size: 18px;
		margin-top: 4px;
	}

	.google-full-count {
		margin-top: 8px;
		font-size: 12px;
		color: rgba(255, 255, 255, 0.35);
	}

	.google-full-count strong {
		color: rgba(255, 255, 255, 0.6);
	}
</style>
