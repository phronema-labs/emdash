---
interface Props {
	title: string;
	subtitle?: string;
	image: string;
}

const { title, subtitle, image } = Astro.props;
---

<section class="page-hero" style={`background-image: url('${image}');`}>
	<div class="page-hero-overlay"></div>
	<div class="container page-hero-inner">
		<h1>{title}</h1>
		{subtitle && <p>{subtitle}</p>}
	</div>
</section>

<style>
	.page-hero {
		position: relative;
		background: center/cover no-repeat;
		padding: 6rem var(--site-gutter);
		color: white;
		text-align: center;
		min-height: 320px;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
	}

	.page-hero-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			160deg,
			rgba(0, 0, 0, 0.9) 0%,
			rgba(0, 0, 0, 0.75) 100%
		);
	}

	.page-hero-inner {
		position: relative;
		z-index: 1;
	}

	.page-hero h1 {
		font-family: var(--font-headline);
		font-size: clamp(2.5rem, 6vw, 5rem);
		font-weight: 900;
		text-transform: uppercase;
		letter-spacing: 0.02em;
		color: white;
	}

	.page-hero p {
		font-family: var(--font-body);
		color: rgba(255, 255, 255, 0.6);
		font-size: 1.1rem;
		margin-top: 1rem;
		max-width: 560px;
		margin-inline: auto;
		line-height: 1.7;
	}

	@media (max-width: 768px) {
		.page-hero { padding: 4rem var(--site-gutter); min-height: 240px; }
	}
</style>
