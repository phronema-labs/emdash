<div class="top-bar">
	<div class="top-bar-inner">
		<div class="top-bar-left">
			<a href="tel:5552345678" class="top-bar-phone">
				<i class="ph ph-phone-fill"></i> (555) 234-5678
			</a>
			<span class="top-bar-sep">|</span>
			<span class="top-bar-info"><i class="ph ph-clock"></i> Mon-Fri 6AM-7PM &bull; Emergency 24/7</span>
			<span class="top-bar-sep top-bar-sep-area">|</span>
			<span class="top-bar-info top-bar-area"><i class="ph ph-map-pin"></i> Phoenix Metro & Surrounding Areas</span>
		</div>
		<div class="top-bar-right">
			<a href="tel:5552345678" class="top-bar-emergency">
				<i class="ph ph-siren-fill"></i> CALL NOW — EMERGENCY RESPONSE
			</a>
		</div>
	</div>
</div>

<style>
	.top-bar {
		background: #111111;
		color: rgba(255, 255, 255, 0.45);
		font-size: 12px;
		font-family: var(--font-body);
		border-bottom: 1px solid rgba(255, 255, 255, 0.05);
	}

	.top-bar-inner {
		max-width: var(--site-max-width);
		margin: 0 auto;
		padding: 7px var(--site-gutter);
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.top-bar-left {
		display: flex;
		align-items: center;
		gap: 6px;
	}

	.top-bar-phone {
		color: rgba(255, 255, 255, 0.8);
		font-weight: 600;
		font-size: 13px;
		text-decoration: none;
		display: flex;
		align-items: center;
		gap: 4px;
		white-space: nowrap;
		transition: color 150ms ease;
	}

	.top-bar-phone i {
		color: var(--color-primary);
	}

	.top-bar-phone:hover {
		color: white;
	}

	.top-bar-sep {
		opacity: 0.2;
		margin: 0 6px;
	}

	.top-bar-info {
		display: inline-flex;
		align-items: center;
		gap: 4px;
	}

	.top-bar-info i {
		font-size: 12px;
		color: rgba(255, 255, 255, 0.35);
	}

	.top-bar-right {
		flex-shrink: 0;
	}

	.top-bar-emergency {
		font-family: var(--font-headline);
		font-weight: 800;
		font-size: 11px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-primary);
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		gap: 5px;
		transition: color 150ms ease;
	}

	.top-bar-emergency i {
		font-size: 13px;
	}

	.top-bar-emergency:hover {
		color: #ef4444;
	}

	@media (max-width: 768px) {
		.top-bar-info,
		.top-bar-sep { display: none; }
	}
</style>
