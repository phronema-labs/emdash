---
interface Props {
	badges?: Array<{
		icon: string;
		label: string;
		sublabel?: string;
	}>;
}

const { badges = [
	{ icon: "ph-shield-check", label: "Licensed & Insured", sublabel: "$2M Coverage" },
	{ icon: "ph-star-fill", label: "4.9 Google Rating", sublabel: "847+ Reviews" },
	{ icon: "ph-lightning-fill", label: "Emergency Response", sublabel: "24/7 Available" },
	{ icon: "ph-seal-check", label: "Lifetime Warranty", sublabel: "All Workmanship" },
	{ icon: "ph-certificate", label: "BBB Accredited", sublabel: "A+ Rating" },
] } = Astro.props;
---

<section class="trust-badges">
	<div class="container">
		<div class="badges-strip">
			{badges.map((badge) => (
				<div class="badge">
					<i class={`ph ${badge.icon}`} />
					<div class="badge-text">
						<strong>{badge.label}</strong>
						{badge.sublabel && <span>{badge.sublabel}</span>}
					</div>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.trust-badges {
		background: #141414;
		border-top: 1px solid rgba(255, 255, 255, 0.06);
		border-bottom: 1px solid rgba(255, 255, 255, 0.06);
		padding: 1.5rem var(--site-gutter);
	}

	.badges-strip {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 2.5rem;
	}

	.badge {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.badge i {
		font-size: 1.6rem;
		color: var(--color-primary);
	}

	.badge-text {
		display: flex;
		flex-direction: column;
		gap: 1px;
	}

	.badge-text strong {
		font-family: var(--font-headline);
		font-size: 0.9rem;
		font-weight: 800;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: white;
	}

	.badge-text span {
		font-family: var(--font-body);
		font-size: 0.75rem;
		color: rgba(255, 255, 255, 0.4);
	}

	@media (max-width: 768px) {
		.badges-strip { gap: 1.5rem; }
		.badge-text span { display: none; }
	}
</style>
