---
import { getMenu, getSiteSettings } from "emdash";
import { EmDashHead } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import TopBar from "../components/TopBar.astro";
import "../styles/site.css";
import "../styles/brand.css";

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const { title, description, image } = Astro.props;
const settings = await getSiteSettings();
const siteTitle = settings?.title || "Apex Roofing Co.";
const fullTitle = title ? `${title} — ${siteTitle}` : siteTitle;
const siteDescription = settings?.tagline || "Storm damage experts. Emergency response. Guaranteed.";
const siteLogo = (settings?.logo as any)?.url ? settings.logo as { mediaId: string; alt?: string; url: string } : null;
const siteFavicon = (settings?.favicon as any)?.url ?? null;

const menu = await getMenu("primary");
const footerMenu = await getMenu("footer");

const pageCtx = createPublicPageContext({
	Astro,
	kind: "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: title ?? siteTitle,
	description: description || siteDescription,
	canonical: Astro.url.href,
	image,
	seo: { ogImage: image },
	siteName: siteTitle,
});
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<link rel="icon" href={siteFavicon || "/favicon.svg"} type="image/svg+xml" />
		<EmDashHead page={pageCtx} />
		<!-- Dramatic condensed headline font + clean body font -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;800;900&family=Barlow:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<link href="https://unpkg.com/@phosphor-icons/web@2.1.2/src/regular/style.css" rel="stylesheet" />
		<link href="https://unpkg.com/@phosphor-icons/web@2.1.2/src/fill/style.css" rel="stylesheet" />
	</head>
	<body>

		<!-- EMERGENCY BANNER — pulses, always visible -->
		<div class="emergency-banner" role="alert">
			<div class="emergency-banner-inner">
				<span class="emergency-pulse-dot"></span>
				<i class="ph ph-siren-fill"></i>
				<strong>STORM DAMAGE?</strong>
				<span class="emergency-divider">|</span>
				<span>24/7 Emergency Response Available</span>
				<span class="emergency-divider">|</span>
				<a href="tel:5552345678" class="emergency-phone">(555) 234-5678</a>
			</div>
		</div>

		<TopBar />

		<header class="site-header">
			<nav class="nav">
				<a href="/" class="site-logo">
					{siteLogo
						? <img src={siteLogo.url} alt={siteLogo.alt || siteTitle} class="site-logo-img" />
						: <span class="site-logo-text">APEX<span class="logo-accent">.</span></span>
					}
				</a>
				<button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false">
					<i class="ph ph-list"></i>
				</button>
				<div class="nav-links">
					{menu?.items.map((item) => (
						<a href={item.url} target={item.target}>{item.label}</a>
					))}
				</div>
				<div class="nav-actions">
					<a href="tel:5552345678" class="nav-phone">
						<i class="ph ph-phone-fill"></i> (555) 234-5678
					</a>
					<a href="/contact" class="nav-cta">FREE ESTIMATE</a>
				</div>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="footer-top">
				<div class="container footer-grid">
					<!-- Brand column -->
					<div class="footer-brand">
						<span class="footer-logo-text">APEX<span class="logo-accent">.</span></span>
						<p class="footer-tagline">{settings?.tagline || "Arizona's most trusted roofing contractor. Storm damage specialists since 2009."}</p>
						<div class="footer-emergency-cta">
							<i class="ph ph-siren-fill"></i>
							<div>
								<strong>24/7 STORM RESPONSE</strong>
								<a href="tel:5552345678">(555) 234-5678</a>
							</div>
						</div>
						<div class="footer-social">
							<a href="https://facebook.com" target="_blank" rel="noopener noreferrer" aria-label="Facebook"><i class="ph ph-facebook-logo" /></a>
							<a href="https://instagram.com" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><i class="ph ph-instagram-logo" /></a>
							<a href="https://google.com" target="_blank" rel="noopener noreferrer" aria-label="Google"><i class="ph ph-google-logo" /></a>
						</div>
					</div>

					<!-- Services column -->
					<div class="footer-col">
						<h4>SERVICES</h4>
						<a href="/services/roof-repair">Roof Repair</a>
						<a href="/services/roof-replacement">Roof Replacement</a>
						<a href="/services/storm-damage">Storm Damage</a>
						<a href="/services/emergency">Emergency Response</a>
						<a href="/services">All Services</a>
					</div>

					<!-- Company column -->
					<div class="footer-col">
						<h4>COMPANY</h4>
						<a href="/about">About Us</a>
						<a href="/work">Our Work</a>
						<a href="/blog">Blog</a>
						<a href="/testimonials">Reviews</a>
						<a href="/faq">FAQ</a>
					</div>

					<!-- Contact column -->
					<div class="footer-col footer-contact">
						<h4>CONTACT</h4>
						<a href="tel:5552345678"><i class="ph ph-phone" /> (555) 234-5678</a>
						<a href="mailto:info@apexroofingco.com"><i class="ph ph-envelope" /> info@apexroofingco.com</a>
						<p><i class="ph ph-map-pin" /> 1200 Rooftop Blvd<br />Phoenix, AZ 85001</p>
						<p class="footer-hours"><i class="ph ph-clock" /> Mon–Fri 6AM–7PM · Emergency 24/7</p>
					</div>
				</div>
			</div>

			<div class="footer-bottom">
				<div class="container footer-bottom-inner">
					<p>&copy; {new Date().getFullYear()} {siteTitle}. All rights reserved. ROC #12345.</p>
					<div class="footer-bottom-links">
						{footerMenu?.items.map((item) => (
							<a href={item.url}>{item.label}</a>
						))}
						<a href="/_emdash/admin" class="admin-link"><i class="ph ph-lock-simple" /> Client Login</a>
					</div>
					<p class="footer-powered">
						Built by <a href="https://phronemalabs.com" class="phronema-link">
							<svg width="14" height="14" viewBox="0 0 64 64" fill="none" style="display:inline-block;vertical-align:-2px;margin-right:3px;">
								<circle cx="27" cy="36" r="16" stroke="#C9963A" stroke-width="5.5"/>
								<circle cx="50" cy="12" r="5" fill="#C9963A"/>
							</svg>Phronema Labs</a>
					</p>
				</div>
			</div>
		</footer>

		<script>
			// Mobile nav toggle
			const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
			const links = document.querySelector<HTMLElement>(".nav-links");
			toggle?.addEventListener("click", () => {
				const expanded = toggle.getAttribute("aria-expanded") === "true";
				toggle.setAttribute("aria-expanded", String(!expanded));
				links?.classList.toggle("nav-open");
			});

			// Scroll-triggered header reveal
			const header = document.querySelector<HTMLElement>(".site-header");
			let lastScroll = 0;
			window.addEventListener("scroll", () => {
				const currentScroll = window.scrollY;
				if (currentScroll > 80) {
					header?.classList.add("scrolled");
				} else {
					header?.classList.remove("scrolled");
				}
				lastScroll = currentScroll;
			});
		</script>

		<style is:global>
			@layer base;

			@layer base {
				*, *::before, *::after {
					box-sizing: border-box;
					margin: 0;
					padding: 0;
				}

				:root {
					--color-bg: #0d0d0d;
					--color-text: #f5f5f5;
					--color-muted: rgba(255, 255, 255, 0.5);
					--color-border: rgba(255, 255, 255, 0.08);
					--color-surface: #141414;
					--color-primary: #dc2626;
					--color-primary-dark: #b91c1c;
					--color-primary-light: rgba(220, 38, 38, 0.15);
					--color-accent: #f59e0b;
					--color-accent-light: rgba(245, 158, 11, 0.15);
					--color-success: #22c55e;
					--color-warning: #f59e0b;

					--font-headline: "Barlow Condensed", "Arial Narrow", sans-serif;
					--font-body: "Barlow", "Arial", sans-serif;
					--font-mono: ui-monospace, "SF Mono", monospace;

					--font-size-xs: 0.75rem;
					--font-size-sm: 0.875rem;
					--font-size-base: 1.0625rem;
					--font-size-md: 1.125rem;
					--font-size-lg: 1.25rem;
					--font-size-xl: 1.5rem;
					--font-size-2xl: 2rem;
					--font-size-3xl: 3rem;
					--font-size-4xl: 4.5rem;
					--font-size-5xl: 6rem;
					--font-size-6xl: 8rem;

					--spacing-xs: 0.25rem;
					--spacing-sm: 0.5rem;
					--spacing-md: 1rem;
					--spacing-lg: 1.5rem;
					--spacing-xl: 2rem;
					--spacing-2xl: 3rem;
					--spacing-3xl: 5rem;
					--spacing-4xl: 7rem;
					--spacing-5xl: 10rem;

					--max-width: 720px;
					--wide-width: 1280px;
					--radius-sm: 4px;
					--radius: 8px;
					--radius-lg: 12px;
					--radius-full: 9999px;

					--transition-fast: 150ms ease;
					--transition-base: 250ms ease;
					--transition-slow: 400ms cubic-bezier(0.4, 0, 0.2, 1);

					--shadow-sm: 0 2px 4px rgba(0, 0, 0, 0.5);
					--shadow: 0 8px 16px rgba(0, 0, 0, 0.5);
					--shadow-lg: 0 20px 40px rgba(0, 0, 0, 0.6);
					--shadow-xl: 0 40px 80px rgba(0, 0, 0, 0.7);
				}

				html {
					scroll-behavior: smooth;
					font-size: 100%;
				}

				body {
					font-family: var(--font-body);
					font-size: var(--font-size-base);
					line-height: 1.6;
					color: var(--color-text);
					background: var(--color-bg);
					-webkit-font-smoothing: antialiased;
					min-height: 100vh;
				}

				a { color: currentColor; text-decoration: none; }
				img { max-width: 100%; height: auto; display: block; }

				h1, h2, h3, h4, h5, h6 {
					font-family: var(--font-headline);
					font-weight: 900;
					line-height: 1.0;
					letter-spacing: 0.01em;
					text-transform: uppercase;
				}

				h1 { font-size: var(--font-size-5xl); }
				h2 { font-size: var(--font-size-4xl); }
				h3 { font-size: var(--font-size-3xl); }
				h4 { font-size: var(--font-size-2xl); }

				p { font-family: var(--font-body); }

				.btn {
					display: inline-flex;
					align-items: center;
					justify-content: center;
					gap: var(--spacing-sm);
					padding: var(--spacing-sm) var(--spacing-xl);
					font-family: var(--font-headline);
					font-size: var(--font-size-md);
					font-weight: 800;
					letter-spacing: 0.08em;
					text-transform: uppercase;
					border-radius: var(--radius-sm);
					cursor: pointer;
					transition: all var(--transition-fast);
				}

				.btn:hover { transform: translateY(-2px); }
				.btn:active { transform: translateY(0); }

				.btn-primary {
					color: white;
					background: var(--color-primary);
					border: 2px solid var(--color-primary);
				}

				.btn-primary:hover {
					background: var(--color-primary-dark);
					border-color: var(--color-primary-dark);
					box-shadow: 0 0 30px rgba(220, 38, 38, 0.4);
				}

				.btn-secondary {
					color: var(--color-text);
					background: transparent;
					border: 2px solid rgba(255, 255, 255, 0.2);
				}

				.btn-secondary:hover {
					border-color: rgba(255, 255, 255, 0.5);
					background: rgba(255, 255, 255, 0.05);
				}

				.btn-accent {
					color: #0d0d0d;
					background: var(--color-accent);
					border: 2px solid var(--color-accent);
					font-weight: 900;
				}

				.btn-accent:hover {
					background: #d97706;
					border-color: #d97706;
					box-shadow: 0 0 30px rgba(245, 158, 11, 0.4);
				}

				.btn-lg {
					padding: 1rem 2.5rem;
					font-size: var(--font-size-lg);
				}

				.btn-xl {
					padding: 1.25rem 3rem;
					font-size: var(--font-size-xl);
				}
			}
		</style>

		<style>
			/* ===== EMERGENCY BANNER ===== */
			.emergency-banner {
				background: var(--color-primary);
				color: white;
				font-family: var(--font-headline);
				font-weight: 800;
				font-size: 0.9rem;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				padding: 0.5rem 1rem;
				text-align: center;
				position: relative;
				z-index: 200;
			}

			.emergency-banner-inner {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 0.75rem;
				flex-wrap: wrap;
			}

			.emergency-pulse-dot {
				width: 8px;
				height: 8px;
				background: white;
				border-radius: 50%;
				animation: pulse-dot 1.5s ease-in-out infinite;
				flex-shrink: 0;
			}

			@keyframes pulse-dot {
				0%, 100% { opacity: 1; transform: scale(1); }
				50% { opacity: 0.4; transform: scale(0.7); }
			}

			.emergency-banner i {
				font-size: 1rem;
			}

			.emergency-divider {
				opacity: 0.4;
			}

			.emergency-phone {
				font-weight: 900;
				color: white;
				text-decoration: underline;
				text-underline-offset: 3px;
				transition: opacity var(--transition-fast);
			}

			.emergency-phone:hover {
				opacity: 0.85;
			}

			/* ===== HEADER ===== */
			.site-header {
				position: sticky;
				top: 0;
				z-index: 100;
				background: rgba(13, 13, 13, 0.95);
				border-bottom: 1px solid rgba(255, 255, 255, 0.06);
				backdrop-filter: blur(12px);
				transition: background var(--transition-base), box-shadow var(--transition-base);
			}

			.site-header.scrolled {
				background: rgba(13, 13, 13, 0.98);
				box-shadow: 0 4px 30px rgba(0, 0, 0, 0.6);
			}

			.nav {
				max-width: var(--site-max-width);
				margin: 0 auto;
				padding: 1rem var(--site-gutter);
				display: flex;
				align-items: center;
				gap: 2rem;
			}

			.site-logo-text {
				font-family: var(--font-headline);
				font-size: 2rem;
				font-weight: 900;
				letter-spacing: 0.04em;
				text-transform: uppercase;
				color: white;
				line-height: 1;
			}

			.site-logo-img {
				height: 44px;
				width: auto;
				display: block;
				filter: brightness(0) invert(1);
			}

			.logo-accent {
				color: var(--color-primary);
			}

			.nav-toggle {
				display: none;
				background: none;
				border: none;
				font-size: 26px;
				cursor: pointer;
				color: white;
				margin-left: auto;
			}

			.nav-links {
				display: flex;
				gap: 2rem;
				margin-left: auto;
			}

			.nav-links a {
				font-family: var(--font-headline);
				font-size: 1rem;
				font-weight: 700;
				letter-spacing: 0.06em;
				text-transform: uppercase;
				color: rgba(255, 255, 255, 0.65);
				transition: color var(--transition-fast);
			}

			.nav-links a:hover { color: white; }

			.nav-actions {
				display: flex;
				align-items: center;
				gap: 1rem;
			}

			.nav-phone {
				font-family: var(--font-headline);
				font-size: 1rem;
				font-weight: 800;
				letter-spacing: 0.04em;
				color: rgba(255, 255, 255, 0.6);
				display: flex;
				align-items: center;
				gap: 0.4rem;
				transition: color var(--transition-fast);
				white-space: nowrap;
			}

			.nav-phone:hover { color: white; }
			.nav-phone i { color: var(--color-primary); }

			.nav-cta {
				padding: 0.6rem 1.25rem;
				font-family: var(--font-headline);
				font-size: 0.875rem;
				font-weight: 900;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				color: white;
				background: var(--color-primary);
				border-radius: var(--radius-sm);
				transition: all var(--transition-fast);
				white-space: nowrap;
			}

			.nav-cta:hover {
				background: var(--color-primary-dark);
				box-shadow: 0 0 20px rgba(220, 38, 38, 0.4);
				transform: translateY(-1px);
			}

			main { min-height: calc(100vh - 200px); }

			/* ===== FOOTER ===== */
			.site-footer {
				background: #0a0a0a;
				color: rgba(255, 255, 255, 0.75);
				border-top: 1px solid rgba(255, 255, 255, 0.06);
			}

			.footer-top {
				padding: 5rem 0 3rem;
			}

			.footer-grid {
				display: grid;
				grid-template-columns: 1.6fr 1fr 1fr 1.3fr;
				gap: 3rem;
			}

			.footer-brand {
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}

			.footer-logo-text {
				font-family: var(--font-headline);
				font-size: 2.5rem;
				font-weight: 900;
				text-transform: uppercase;
				color: white;
				line-height: 1;
			}

			.footer-tagline {
				font-size: 0.9rem;
				color: rgba(255, 255, 255, 0.45);
				line-height: 1.7;
				max-width: 280px;
			}

			.footer-emergency-cta {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				background: rgba(220, 38, 38, 0.12);
				border: 1px solid rgba(220, 38, 38, 0.3);
				border-radius: var(--radius-sm);
				padding: 0.75rem 1rem;
				margin-top: 0.5rem;
			}

			.footer-emergency-cta i {
				font-size: 1.5rem;
				color: var(--color-primary);
			}

			.footer-emergency-cta strong {
				display: block;
				font-family: var(--font-headline);
				font-size: 0.75rem;
				letter-spacing: 0.1em;
				color: var(--color-primary);
			}

			.footer-emergency-cta a {
				display: block;
				font-family: var(--font-headline);
				font-size: 1.25rem;
				font-weight: 900;
				color: white;
				transition: color var(--transition-fast);
			}

			.footer-emergency-cta a:hover { color: var(--color-accent); }

			.footer-social {
				display: flex;
				gap: 0.5rem;
				margin-top: 0.5rem;
			}

			.footer-social a {
				width: 36px;
				height: 36px;
				display: flex;
				align-items: center;
				justify-content: center;
				border: 1px solid rgba(255, 255, 255, 0.1);
				border-radius: var(--radius-sm);
				color: rgba(255, 255, 255, 0.4);
				font-size: 18px;
				transition: all var(--transition-fast);
			}

			.footer-social a:hover {
				background: var(--color-primary);
				border-color: var(--color-primary);
				color: white;
			}

			.footer-col h4 {
				font-family: var(--font-headline);
				font-size: 0.875rem;
				font-weight: 800;
				text-transform: uppercase;
				letter-spacing: 0.12em;
				color: white;
				margin-bottom: 1.25rem;
			}

			.footer-col a,
			.footer-col p {
				display: flex;
				align-items: flex-start;
				gap: 0.5rem;
				font-size: 0.9rem;
				color: rgba(255, 255, 255, 0.45);
				padding: 0.3rem 0;
				transition: color var(--transition-fast);
				text-decoration: none;
				line-height: 1.5;
			}

			.footer-col a:hover { color: white; }

			.footer-col i {
				font-size: 15px;
				color: var(--color-primary);
				flex-shrink: 0;
				margin-top: 2px;
			}

			.footer-hours {
				font-size: 0.8rem !important;
				margin-top: 0.25rem;
			}

			.footer-bottom {
				border-top: 1px solid rgba(255, 255, 255, 0.06);
			}

			.footer-bottom-inner {
				padding: 1.5rem 0;
				display: flex;
				justify-content: space-between;
				align-items: center;
				flex-wrap: wrap;
				gap: 1rem;
				font-size: 0.8rem;
				color: rgba(255, 255, 255, 0.25);
			}

			.footer-bottom-links {
				display: flex;
				gap: 1.5rem;
				flex-wrap: wrap;
			}

			.footer-bottom-links a {
				color: rgba(255, 255, 255, 0.25);
				text-decoration: none;
				transition: color var(--transition-fast);
			}

			.footer-bottom-links a:hover { color: rgba(255, 255, 255, 0.6); }

			.admin-link {
				display: flex;
				align-items: center;
				gap: 4px;
			}

			.footer-powered a { color: rgba(255, 255, 255, 0.35); }

			.phronema-link {
				font-weight: 600;
				color: #FF6B35 !important;
				transition: opacity var(--transition-fast);
			}

			.phronema-link:hover { opacity: 0.8; }

			@media (max-width: 1024px) {
