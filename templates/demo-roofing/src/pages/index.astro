---
import { getEmDashEntry, getEmDashCollection } from "emdash";
import { PortableText, Image } from "emdash/ui";
import Base from "../layouts/Base.astro";
import TrustBadges from "../components/TrustBadges.astro";
import BrandStrip from "../components/BrandStrip.astro";
import TestimonialCarousel from "../components/TestimonialCarousel.astro";
import CostEstimator from "../components/CostEstimator.astro";
import ServiceCard from "../components/ServiceCard.astro";
import GoogleReviews from "../components/GoogleReviews.astro";

const { entry, cacheHint } = await getEmDashEntry("pages", "home");
if (cacheHint) Astro.response.headers.set("Cache-Control", cacheHint);

const { entries: services } = await getEmDashCollection("services", { status: "published" });
const { entries: testimonials } = await getEmDashCollection("testimonials", { status: "published" });
const { entries: projects } = await getEmDashCollection("projects", { status: "published" });

const testimonialData = testimonials.map((t) => ({
	quote: t.data.quote,
	author: t.data.author,
	role: t.data.role,
	company: t.data.company,
	rating: t.data.rating as number | undefined,
}));
---

<Base>
	{/* ===== HERO — Full viewport, cinematic dark ===== */}
	<section class="hero-section" aria-label="Hero">
		<div class="hero-bg"></div>
		<div class="hero-spotlight"></div>
		<div class="hero-overlay"></div>

		<div class="hero-inner">
			<div class="hero-content">
				<div class="hero-eyebrow">
					<span class="hero-eyebrow-dot"></span>
					<span>Licensed & Insured · ROC #12345 · Since 2009</span>
				</div>

				<h1 class="hero-headline">
					<span class="hero-line-1">WE PROTECT</span>
					<span class="hero-line-2">WHAT <span class="hero-accent-word">MATTERS</span></span>
					<span class="hero-line-3">MOST</span>
				</h1>

				<p class="hero-sub">
					Arizona's most trusted roofing contractor. Storm damage specialists.
					When disaster strikes your roof, we respond — fast.
				</p>

				<div class="hero-actions">
					<a href="/contact" class="btn btn-primary btn-xl hero-cta-primary">
						<i class="ph ph-arrow-right"></i> GET FREE ESTIMATE
					</a>
					<a href="tel:5552345678" class="btn btn-secondary btn-xl hero-cta-secondary">
						<i class="ph ph-phone-call"></i> CALL NOW
					</a>
				</div>

				<div class="hero-proof">
					<GoogleReviews rating={4.9} reviewCount={847} style="badge" />
				</div>
			</div>

			<!-- Diagonal accent lines (decorative) -->
			<div class="hero-geo" aria-hidden="true">
				<div class="hero-geo-line hero-geo-line-1"></div>
				<div class="hero-geo-line hero-geo-line-2"></div>
				<div class="hero-geo-line hero-geo-line-3"></div>
			</div>
		</div>

		<!-- Stats overlapping the hero bottom edge -->
		<div class="hero-stats-band">
			<div class="hero-stats">
				<div class="hero-stat">
					<span class="hero-stat-number" data-count="15">0</span>
					<span class="hero-stat-suffix">+</span>
					<span class="hero-stat-label">Years Experience</span>
				</div>
				<div class="hero-stat-sep" aria-hidden="true"></div>
				<div class="hero-stat">
					<span class="hero-stat-number" data-count="12000">0</span>
					<span class="hero-stat-suffix">+</span>
					<span class="hero-stat-label">Roofs Replaced</span>
				</div>
				<div class="hero-stat-sep" aria-hidden="true"></div>
				<div class="hero-stat">
					<span class="hero-stat-number" data-count="98">0</span>
					<span class="hero-stat-suffix">%</span>
					<span class="hero-stat-label">Customer Satisfaction</span>
				</div>
				<div class="hero-stat-sep" aria-hidden="true"></div>
				<div class="hero-stat">
					<span class="hero-stat-number" data-count="24">0</span>
					<span class="hero-stat-suffix">/7</span>
					<span class="hero-stat-label">Storm Response</span>
				</div>
			</div>
		</div>
	</section>

	{/* ===== TRUST BAR ===== */}
	<TrustBadges />

	{/* ===== SERVICES — dark with red accents ===== */}
	{services.length > 0 && (
		<section class="section section-services">
			<div class="container">
				<div class="section-header">
					<span class="section-label">WHAT WE DO</span>
					<h2>Our Services</h2>
					<p>From emergency storm response to full roof replacement. We handle it all with precision and speed.</p>
				</div>
				<div class="services-grid">
					{services.slice(0, 4).map((service) => (
						<ServiceCard
							title={service.data.title}
							summary={service.data.summary}
							icon={service.data.icon}
							priceFrom={service.data.price_from}
							href={`/services/${service.slug}`}
							ctaLabel={service.data.cta_label}
						/>
					))}
				</div>
				<div class="section-cta-row">
					<a href="/services" class="btn btn-secondary">View All Services <i class="ph ph-arrow-right"></i></a>
				</div>
			</div>
		</section>
	)}

	{/* ===== WHY APEX — dark with red spotlight effect ===== */}
	<section class="section section-why">
		<div class="why-spotlight" aria-hidden="true"></div>
		<div class="container">
			<div class="why-layout">
				<div class="why-left">
					<span class="section-label">WHY CHOOSE US</span>
					<h2>Built for <span class="text-accent">battle.</span></h2>
					<p class="why-intro">Roofing isn't just construction — it's the last line of defense between your family and the elements. We take that seriously.</p>

					<div class="why-list">
						<div class="why-item">
							<div class="why-item-icon"><i class="ph ph-lightning-fill"></i></div>
							<div>
								<h3>24/7 Storm Response</h3>
								<p>Crews mobilize within hours of major weather events. Emergency tarping included on all storm calls.</p>
							</div>
						</div>
						<div class="why-item">
							<div class="why-item-icon"><i class="ph ph-currency-dollar"></i></div>
							<div>
								<h3>Insurance Experts</h3>
								<p>We work directly with your insurance company. Most repairs cost you nothing out of pocket.</p>
							</div>
						</div>
						<div class="why-item">
							<div class="why-item-icon"><i class="ph ph-seal-check"></i></div>
							<div>
								<h3>Lifetime Workmanship Warranty</h3>
								<p>Every installation is backed by our lifetime workmanship warranty. We stand behind our work, period.</p>
							</div>
						</div>
					</div>
				</div>

				<div class="why-right">
					<div class="why-image-stack">
						<img
							src="https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=800&h=600&fit=crop"
							alt="Roofing crew at work"
							class="why-img"
							loading="lazy"
						/>
						<div class="why-image-badge">
							<i class="ph ph-shield-check-fill"></i>
							<span>FULLY INSURED<br />$2M COVERAGE</span>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	{/* ===== RECENT PROJECTS — full-bleed dramatic grid ===== */}
	{projects.length > 0 && (
		<section class="section section-projects">
			<div class="container">
				<div class="section-header">
					<span class="section-label">OUR WORK</span>
					<h2>Recent Projects</h2>
					<p>See our craftsmanship across the greater Phoenix metro.</p>
				</div>
				<div class="projects-grid">
					{projects.slice(0, 3).map((project, i) => (
						<a href={`/work/${project.slug}`} class:list={["project-card", { "project-card-featured": i === 0 }]}>
							<div class="project-card-img">
								{project.data.featured_image ? (
									<Image image={project.data.featured_image} />
								) : (
									<img src="https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=800&h=500&fit=crop" alt={project.data.title} loading="lazy" />
								)}
							</div>
							<div class="project-card-overlay">
								<div class="project-card-info">
									<h3>{project.data.title}</h3>
									<p>{project.data.summary}</p>
									<span class="project-card-cta">VIEW PROJECT <i class="ph ph-arrow-right"></i></span>
								</div>
							</div>
						</a>
					))}
				</div>
				<div class="section-cta-row">
					<a href="/work" class="btn btn-secondary">View All Projects <i class="ph ph-arrow-right"></i></a>
				</div>
			</div>
		</section>
	)}

	{/* ===== BRANDS strip ===== */}
	<BrandStrip />

	{/* ===== TESTIMONIALS — dark with amber stars ===== */}
	{testimonialData.length > 0 && (
		<section class="section section-testimonials">
			<div class="container">
				<div class="section-header">
					<span class="section-label">TESTIMONIALS</span>
					<h2>Real Homeowners. Real Results.</h2>
					<div class="section-review-badge">
						<GoogleReviews rating={4.9} reviewCount={847} style="badge" />
					</div>
				</div>
				<TestimonialCarousel testimonials={testimonialData} />
			</div>
		</section>
	)}

	{/* ===== COST ESTIMATOR ===== */}
	<CostEstimator />

	{/* ===== FINAL CTA — dark with red gradient ===== */}
	<section class="section-final-cta">
		<div class="final-cta-bg" aria-hidden="true"></div>
		<div class="container final-cta-inner">
			<div class="final-cta-eyebrow">
				<span class="final-cta-pulse"></span>
				<span>AVAILABLE NOW — 24/7 EMERGENCY SERVICE</span>
			</div>
			<h2 class="final-cta-headline">Don't wait until<br /><span class="text-red">the damage spreads.</span></h2>
			<p class="final-cta-sub">One call gets a licensed crew to your property, fast. Free inspection. Free estimate. No pressure.</p>
			<div class="final-cta-actions">
				<a href="/contact" class="btn btn-accent btn-xl">
					<i class="ph ph-calendar-check"></i> SCHEDULE FREE INSPECTION
				</a>
				<a href="tel:5552345678" class="btn btn-secondary btn-xl">
					<i class="ph ph-phone-call"></i> (555) 234-5678
				</a>
			</div>
		</div>
	</section>
</Base>

<script>
	// Counter animation for hero stats
	function animateCount(el: HTMLElement) {
		const target = parseInt(el.dataset.count || "0", 10);
		const duration = 1800;
		const startTime = performance.now();

		function update(currentTime: number) {
			const elapsed = currentTime - startTime;
			const progress = Math.min(elapsed / duration, 1);
			const eased = 1 - Math.pow(1 - progress, 3);
			const current = Math.round(eased * target);
			el.textContent = current >= 1000 ? (current / 1000).toFixed(0) + "k" : String(current);
			if (progress < 1) requestAnimationFrame(update);
		}

		requestAnimationFrame(update);
	}

	// Intersection observer to trigger counters
	const counters = document.querySelectorAll<HTMLElement>("[data-count]");
	const observer = new IntersectionObserver((entries) => {
		entries.forEach((entry) => {
			if (entry.isIntersecting) {
				animateCount(entry.target as HTMLElement);
				observer.unobserve(entry.target);
			}
		});
	}, { threshold: 0.5 });

	counters.forEach((counter) => observer.observe(counter));

	// Parallax hero background on scroll
	const heroBg = document.querySelector<HTMLElement>(".hero-bg");
	window.addEventListener("scroll", () => {
		if (heroBg) {
			heroBg.style.transform = `translateY(${window.scrollY * 0.35}px)`;
		}
	}, { passive: true });
</script>

<style>
	/* ===== HERO ===== */
	.hero-section {
		position: relative;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		justify-content: center;
		overflow: hidden;
		padding-bottom: 0;
	}

	.hero-bg {
		position: absolute;
		inset: -20%;
		background: url("https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=1800&h=1100&fit=crop") center/cover no-repeat;
		will-change: transform;
	}

	.hero-spotlight {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(ellipse 80% 60% at 20% 50%, rgba(220, 38, 38, 0.12) 0%, transparent 60%),
			radial-gradient(ellipse 50% 40% at 80% 30%, rgba(245, 158, 11, 0.06) 0%, transparent 50%);
		z-index: 1;
	}

	.hero-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			160deg,
			rgba(0, 0, 0, 0.93) 0%,
			rgba(0, 0, 0, 0.82) 50%,
			rgba(0, 0, 0, 0.88) 100%
		);
		z-index: 2;
	}

	.hero-inner {
		position: relative;
		z-index: 3;
		max-width: var(--site-max-width);
		margin: 0 auto;
		padding: 6rem var(--site-gutter) 10rem;
		width: 100%;
		display: flex;
		align-items: center;
	}

	.hero-content {
		max-width: 820px;
	}

	.hero-eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		font-family: var(--font-headline);
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.5);
		margin-bottom: 1.5rem;
	}

	.hero-eyebrow-dot {
		width: 6px;
		height: 6px;
		background: var(--color-primary);
		border-radius: 50%;
		animation: pulse-dot 1.5s ease-in-out infinite;
	}

	@keyframes pulse-dot {
		0%, 100% { opacity: 1; transform: scale(1); }
		50% { opacity: 0.4; transform: scale(0.7); }
	}

	.hero-headline {
		display: flex;
		flex-direction: column;
		font-family: var(--font-headline);
		font-weight: 900;
		text-transform: uppercase;
		line-height: 0.92;
		letter-spacing: 0.02em;
		margin-bottom: 2rem;
	}

	.hero-line-1 {
		font-size: clamp(3.5rem, 10vw, 8rem);
		color: white;
	}

	.hero-line-2 {
		font-size: clamp(3.5rem, 10vw, 8rem);
		color: white;
	}

	.hero-line-3 {
		font-size: clamp(4rem, 14vw, 12rem);
		color: white;
		line-height: 0.85;
		/* Outlined text effect */
		-webkit-text-stroke: 2px rgba(255, 255, 255, 0.15);
		color: transparent;
	}

	.hero-accent-word {
		color: var(--color-primary);
		-webkit-text-stroke: 0;
	}

	.hero-sub {
		font-family: var(--font-body);
		font-size: 1.2rem;
		line-height: 1.7;
		color: rgba(255, 255, 255, 0.7);
		max-width: 560px;
		margin-bottom: 2.5rem;
	}

	.hero-actions {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
		margin-bottom: 2rem;
	}

	.hero-cta-primary {
		background: var(--color-primary) !important;
		border-color: var(--color-primary) !important;
		box-shadow: 0 0 40px rgba(220, 38, 38, 0.35);
	}

	.hero-cta-primary:hover {
		box-shadow: 0 0 60px rgba(220, 38, 38, 0.5) !important;
		transform: translateY(-3px) !important;
	}

	.hero-cta-secondary {
		border-color: rgba(255, 255, 255, 0.25) !important;
		color: white !important;
	}

	.hero-cta-secondary:hover {
		border-color: rgba(255, 255, 255, 0.6) !important;
		background: rgba(255, 255, 255, 0.06) !important;
	}

	.hero-proof {
		margin-top: 0.5rem;
	}

	/* Geometric accent lines */
	.hero-geo {
		position: absolute;
		right: 0;
		top: 0;
		bottom: 0;
		width: 40%;
		pointer-events: none;
	}

	.hero-geo-line {
		position: absolute;
		background: linear-gradient(to bottom, transparent, rgba(220, 38, 38, 0.08), transparent);
		width: 1px;
		top: 0;
		bottom: 0;
	}

	.hero-geo-line-1 { right: 30%; }
	.hero-geo-line-2 { right: 20%; opacity: 0.6; }
	.hero-geo-line-3 { right: 10%; opacity: 0.3; }

	/* ===== STATS BAND — overlaps hero bottom ===== */
	.hero-stats-band {
		position: relative;
		z-index: 10;
		background: var(--color-primary);
		width: 100%;
	}

	.hero-stats {
		max-width: var(--site-max-width);
		margin: 0 auto;
		padding: 2rem var(--site-gutter);
		display: grid;
		grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
		align-items: center;
		gap: 0;
	}

	.hero-stat {
		text-align: center;
		padding: 0.5rem;
	}

	.hero-stat-number {
		display: inline;
		font-family: var(--font-headline);
		font-size: clamp(2.5rem, 5vw, 4rem);
		font-weight: 900;
		color: white;
		line-height: 1;
	}

	.hero-stat-suffix {
		font-family: var(--font-headline);
		font-size: clamp(1.5rem, 3vw, 2.5rem);
		font-weight: 900;
		color: rgba(255, 255, 255, 0.7);
	}

	.hero-stat-label {
		display: block;
		font-family: var(--font-headline);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.7);
		margin-top: 0.25rem;
	}

	.hero-stat-sep {
		width: 1px;
		height: 50px;
		background: rgba(255, 255, 255, 0.25);
	}

	/* ===== SECTION COMMON ===== */
	.section-header {
		text-align: center;
		margin-bottom: 4rem;
	}

	.section-label {
		display: inline-block;
		font-family: var(--font-headline);
		font-size: 0.75rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.2em;
		color: var(--color-primary);
		margin-bottom: 1rem;
	}

	.section-header h2 {
		font-size: clamp(2.5rem, 5vw, 4rem);
		color: white;
		margin-bottom: 1rem;
	}

	.section-header p {
		font-family: var(--font-body);
		color: rgba(255, 255, 255, 0.5);
		font-size: 1.1rem;
		max-width: 560px;
		margin-inline: auto;
		line-height: 1.7;
	}

	.section-review-badge {
		margin-top: 1.5rem;
		display: flex;
		justify-content: center;
	}

	.section-cta-row {
		text-align: center;
		margin-top: 3rem;
	}

	.text-accent { color: var(--color-accent); }
	.text-red { color: var(--color-primary); }

	/* ===== SERVICES ===== */
	.section-services {
		background: var(--color-surface);
		padding-block: var(--space-4xl);
		padding-inline: var(--site-gutter);
	}

	.services-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1.5rem;
	}

	/* ===== WHY SECTION ===== */
	.section-why {
		background: var(--color-bg);
		padding-block: var(--space-4xl);
		padding-inline: var(--site-gutter);
		position: relative;
		overflow: hidden;
	}

	.why-spotlight {
		position: absolute;
		top: 50%;
		left: -10%;
		width: 60%;
		height: 80%;
		background: radial-gradient(ellipse, rgba(220, 38, 38, 0.07) 0%, transparent 70%);
		transform: translateY(-50%);
		pointer-events: none;
	}

	.why-layout {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 5rem;
		align-items: center;
	}

	.why-left {
		position: relative;
		z-index: 1;
	}

	.why-left h2 {
		font-size: clamp(2.5rem, 4vw, 4rem);
		color: white;
		margin: 1rem 0 1.5rem;
		line-height: 1;
	}

	.why-intro {
		font-size: 1.1rem;
		color: rgba(255, 255, 255, 0.55);
		line-height: 1.8;
		margin-bottom: 2.5rem;
		max-width: 480px;
	}

	.why-list {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.why-item {
		display: flex;
		gap: 1.25rem;
		align-items: flex-start;
	}

	.why-item-icon {
		width: 48px;
		height: 48px;
		background: rgba(220, 38, 38, 0.12);
		border: 1px solid rgba(220, 38, 38, 0.25);
		border-radius: var(--radius-sm);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 1.4rem;
		color: var(--color-primary);
		flex-shrink: 0;
		transition: all var(--ease-base);
	}

	.why-item:hover .why-item-icon {
		background: rgba(220, 38, 38, 0.2);
		box-shadow: 0 0 20px rgba(220, 38, 38, 0.2);
	}

	.why-item h3 {
		font-size: 1.3rem;
		color: white;
		margin-bottom: 0.4rem;
		line-height: 1.2;
	}

	.why-item p {
		font-size: 0.95rem;
		color: rgba(255, 255, 255, 0.5);
		line-height: 1.7;
	}

	.why-right {
		position: relative;
	}

	.why-image-stack {
		position: relative;
	}

	.why-img {
		width: 100%;
		aspect-ratio: 4/3;
		object-fit: cover;
		border-radius: var(--radius-md);
		display: block;
		/* Diagonal clip effect */
		clip-path: polygon(0 0, 100% 0, 100% 90%, 92% 100%, 0 100%);
	}

	.why-image-badge {
		position: absolute;
		bottom: -1.5rem;
		left: -1.5rem;
		background: var(--color-primary);
		color: white;
		padding: 1.25rem 1.5rem;
		border-radius: var(--radius-sm);
		display: flex;
		align-items: center;
		gap: 0.75rem;
		box-shadow: 0 0 40px rgba(220, 38, 38, 0.4);
	}

	.why-image-badge i {
		font-size: 2rem;
