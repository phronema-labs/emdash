---
---

<section class="estimator section" id="estimator">
	<div class="container">
		<header class="estimator-header">
			<h2>Estimate Your Legal Fees</h2>
			<p>Select your matter type and complexity for a ballpark fee range. For an exact quote, <a href="/contact">schedule a free consultation</a>.</p>
		</header>

		<div class="estimator-form" data-estimator>
			<div class="estimator-step">
				<label class="step-label">1. What type of matter?</label>
				<div class="option-grid" data-field="service">
					<button class="option-btn" data-value="business">
						<i class="ph ph-briefcase" />
						<span>Business Law</span>
					</button>
					<button class="option-btn" data-value="estate">
						<i class="ph ph-file-text" />
						<span>Estate Planning</span>
					</button>
					<button class="option-btn" data-value="family">
						<i class="ph ph-users" />
						<span>Family Law</span>
					</button>
				</div>
			</div>

			<div class="estimator-step">
				<label class="step-label">2. How would you describe the matter?</label>
				<div class="option-grid" data-field="type">
					<button class="option-btn" data-value="simple">
						<i class="ph ph-check-circle" />
						<span>Straightforward</span>
					</button>
					<button class="option-btn" data-value="moderate">
						<i class="ph ph-equals" />
						<span>Moderate Complexity</span>
					</button>
					<button class="option-btn" data-value="complex">
						<i class="ph ph-git-branch" />
						<span>Complex / Disputed</span>
					</button>
				</div>
			</div>

			<div class="estimator-step">
				<label class="step-label">3. How soon do you need to proceed?</label>
				<div class="option-grid" data-field="urgency">
					<button class="option-btn" data-value="routine">
						<i class="ph ph-calendar" />
						<span>No rush — planning ahead</span>
					</button>
					<button class="option-btn" data-value="soon">
						<i class="ph ph-clock" />
						<span>Within the next month</span>
					</button>
					<button class="option-btn" data-value="urgent">
						<i class="ph ph-warning" />
						<span>Urgent — deadline or dispute</span>
					</button>
				</div>
			</div>

			<div class="estimator-result" data-result style="display: none;">
				<div class="result-card">
					<span class="result-label">Estimated Fee Range</span>
					<span class="result-price" data-price></span>
					<span class="result-note">*Exact fees provided after a consultation. Flat-fee arrangements available for many matters.</span>
					<a href="/contact" class="btn btn-primary btn-lg">Schedule a Free Consultation</a>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	document.querySelectorAll<HTMLElement>("[data-estimator]").forEach((form) => {
		const state: Record<string, string> = {};
		const result = form.querySelector<HTMLElement>("[data-result]")!;
		const priceEl = form.querySelector<HTMLElement>("[data-price]")!;

		const PRICES: Record<string, Record<string, Record<string, string>>> = {
			business: {
				simple: { routine: "$750 – $2,500", soon: "$750 – $2,500", urgent: "$1,200 – $3,500" },
				moderate: { routine: "$2,500 – $8,000", soon: "$2,500 – $9,000", urgent: "$3,500 – $12,000" },
				complex: { routine: "$8,000 – $25,000+", soon: "$8,000 – $28,000+", urgent: "$12,000 – $35,000+" },
			},
			estate: {
				simple: { routine: "$1,200 – $2,500", soon: "$1,200 – $2,800", urgent: "$1,800 – $3,500" },
				moderate: { routine: "$2,500 – $6,000", soon: "$2,800 – $6,500", urgent: "$3,500 – $8,000" },
				complex: { routine: "$6,000 – $20,000+", soon: "$6,500 – $22,000+", urgent: "$8,000 – $28,000+" },
			},
			family: {
				simple: { routine: "$1,500 – $4,000", soon: "$1,500 – $4,500", urgent: "$2,500 – $6,000" },
				moderate: { routine: "$4,000 – $12,000", soon: "$4,500 – $13,000", urgent: "$6,000 – $18,000" },
				complex: { routine: "$12,000 – $40,000+", soon: "$14,000 – $45,000+", urgent: "$18,000 – $55,000+" },
			},
		};

		form.querySelectorAll<HTMLElement>(".option-btn").forEach((btn) => {
			btn.addEventListener("click", () => {
				const field = btn.closest("[data-field]")?.getAttribute("data-field");
				if (!field) return;

				// Toggle active state
				btn.closest(".option-grid")?.querySelectorAll(".option-btn").forEach((b) => b.classList.remove("active"));
				btn.classList.add("active");
				state[field] = btn.dataset.value!;

				// Show result when all 3 selected
				if (state.service && state.type && state.urgency) {
					const price = PRICES[state.service]?.[state.type]?.[state.urgency] ?? "Contact us for a quote";
					priceEl.textContent = price;
					result.style.display = "block";
					result.scrollIntoView({ behavior: "smooth", block: "nearest" });
				}
			});
		});
	});
</script>

<style>
	.estimator {
		background: white;
	}

	.estimator-header {
		text-align: center;
		margin-bottom: var(--spacing-3xl);
	}

	.estimator-header h2 {
		font-size: var(--font-size-2xl);
		font-weight: 800;
	}

	.estimator-header p {
		color: var(--color-muted);
		margin-top: var(--spacing-sm);
	}

	.estimator-header a {
		color: var(--color-primary);
		text-decoration: underline;
	}

	.estimator-form {
		max-width: 700px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: var(--spacing-2xl);
	}

	.step-label {
		display: block;
		font-weight: 600;
		margin-bottom: var(--spacing-md);
		font-size: var(--font-size-lg);
	}

	.option-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-md);
	}

	.option-btn {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--spacing-sm);
		padding: var(--spacing-lg);
		background: var(--color-bg);
		border: 2px solid var(--color-border);
		border-radius: var(--radius-lg);
		cursor: pointer;
		font-family: inherit;
		font-size: var(--font-size-sm);
		font-weight: 500;
		color: var(--color-text);
		transition: all 0.25s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.option-btn i {
		font-size: 28px;
		color: var(--color-muted);
		transition: color 0.25s ease, transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.option-btn:hover {
		border-color: var(--color-primary);
		transform: translateY(-2px);
		box-shadow: 0 4px 12px rgba(30, 107, 184, 0.1);
	}

	.option-btn:hover i {
		color: var(--color-primary);
		transform: scale(1.1);
	}

	.option-btn.active {
		border-color: var(--color-primary);
		background: var(--color-primary);
		color: white;
		transform: translateY(-2px);
		box-shadow: 0 4px 16px rgba(30, 107, 184, 0.25);
	}

	.option-btn.active i {
		color: white;
	}

	.result-card {
		text-align: center;
		padding: var(--spacing-2xl);
		background: var(--color-bg);
		border: 2px solid var(--color-primary);
		border-radius: var(--radius-lg);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--spacing-md);
		animation: slideUp 0.3s ease;
	}

	@keyframes slideUp {
		from { opacity: 0; transform: translateY(10px); }
		to { opacity: 1; transform: translateY(0); }
	}

	.result-label {
		font-size: var(--font-size-sm);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--color-muted);
	}

	.result-price {
		font-size: var(--font-size-3xl);
		font-weight: 800;
		color: var(--color-primary);
	}

	.result-note {
		font-size: var(--font-size-xs);
		color: var(--color-muted);
		font-style: italic;
	}

	@media (max-width: 600px) {
		.option-grid {
			grid-template-columns: 1fr;
		}

		.option-btn {
			flex-direction: row;
			justify-content: center;
		}
	}
</style>
