---
interface Props {
	title: string;
	summary?: string;
	icon?: string;
	priceFrom?: string;
	href: string;
	ctaLabel?: string;
}

const { title, summary, icon, priceFrom, href, ctaLabel } = Astro.props;

const ICON_MAP: Record<string, string> = {
	code: "ph-code",
	"paint-brush": "ph-paint-brush",
	"chart-line-up": "ph-chart-line-up",
	globe: "ph-globe",
	devices: "ph-devices",
	"shield-check": "ph-shield-check",
};
---

<a href={href} class="service-card">
	<div class="service-card-inner">
		{icon && (
			<div class="service-icon">
				<i class={`ph ${ICON_MAP[icon] || `ph-${icon}`}`} />
			</div>
		)}
		<h3 class="service-title">{title}</h3>
		{summary && <p class="service-summary">{summary}</p>}
		{priceFrom && <p class="service-price">From {priceFrom}</p>}
		<span class="service-link">
			{ctaLabel || "Learn More"}
			<svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
				<path d="M1 7h12M7.5 1.5 13 7l-5.5 5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
			</svg>
		</span>
	</div>
	<!-- Hover highlight strip -->
	<span class="service-card-accent" aria-hidden="true"></span>
</a>

<style>
	.service-card {
		display: flex;
		flex-direction: column;
		position: relative;
		text-decoration: none;
		color: var(--color-text);
		border-radius: var(--radius-lg);
		overflow: hidden;
		background: white;
		border: 1px solid rgba(0, 0, 0, 0.07);
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04), 0 1px 2px rgba(0, 0, 0, 0.03);
		transition: transform 0.32s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.32s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.service-card::before {
		content: "";
		position: absolute;
		inset: 0;
		background: var(--gradient-mesh, none);
		opacity: 0;
		transition: opacity 0.4s ease;
		pointer-events: none;
	}

	.service-card:hover {
		transform: translateY(-5px) scale(1.01);
		box-shadow: 0 16px 40px rgba(0, 0, 0, 0.1), 0 4px 12px rgba(0, 0, 0, 0.06);
	}

	.service-card:hover::before {
		opacity: 1;
	}

	.service-card-inner {
		display: flex;
		flex-direction: column;
		padding: var(--spacing-xl) var(--spacing-xl) var(--spacing-lg);
		flex: 1;
		position: relative;
		z-index: 1;
	}

	/* Bottom accent bar that grows on hover */
	.service-card-accent {
		display: block;
		height: 3px;
		background: linear-gradient(90deg, var(--color-primary), var(--color-accent));
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
		border-radius: 0 0 0 0;
	}

	.service-card:hover .service-card-accent {
		transform: scaleX(1);
	}

	.service-icon {
		width: 52px;
		height: 52px;
		border-radius: var(--radius-md);
		background: var(--color-primary-light);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 24px;
		color: var(--color-primary);
		margin-bottom: var(--spacing-md);
		transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.3s ease, color 0.3s ease, box-shadow 0.3s ease;
	}

	.service-card:hover .service-icon {
		background: var(--color-primary);
		color: white;
		transform: scale(1.1) rotate(-3deg);
		box-shadow: 0 6px 16px color-mix(in srgb, var(--color-primary) 30%, transparent);
	}

	.service-title {
		font-size: var(--font-size-xl);
		font-weight: 400;
		margin-bottom: var(--spacing-sm);
		line-height: 1.2;
	}

	.service-summary {
		color: var(--color-muted);
		line-height: 1.65;
		flex: 1;
		font-size: var(--font-size-sm);
	}

	.service-price {
		color: var(--color-primary);
		font-weight: 600;
		font-size: var(--font-size-sm);
		margin-top: var(--spacing-md);
		font-family: var(--font-body, system-ui);
	}

	.service-link {
		margin-top: var(--spacing-lg);
		color: var(--color-primary);
		font-weight: 600;
		font-size: var(--font-size-sm);
		font-family: var(--font-body, system-ui);
		letter-spacing: 0.01em;
		display: inline-flex;
		align-items: center;
		gap: 6px;
		transition: gap 0.3s cubic-bezier(0.22, 1, 0.36, 1), color 0.2s ease;
	}

	.service-card:hover .service-link {
		gap: 10px;
		color: var(--color-accent);
	}
</style>
