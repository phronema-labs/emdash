---
interface Props {
	badges?: Array<{
		icon: string;
		label: string;
		sublabel?: string;
	}>;
}

const { badges = [
	{ icon: "ph-scales", label: "AV Preeminent Rated", sublabel: "Martindale-Hubbell" },
	{ icon: "ph-star", label: "4.9 Client Rating", sublabel: "217+ Reviews" },
	{ icon: "ph-handshake", label: "Partner-Led Service", sublabel: "No Junior Handoffs" },
	{ icon: "ph-seal-check", label: "State Bar Members", sublabel: "In Good Standing" },
	{ icon: "ph-trophy", label: "Best Lawyers in America", sublabel: "8 Consecutive Years" },
] } = Astro.props;
---

<section class="trust-badges">
	<div class="container">
		<div class="badges-strip">
			{badges.map((badge) => (
				<div class="badge">
					<div class="badge-icon">
						<i class={`ph ${badge.icon}`} />
					</div>
					<div class="badge-text">
						<strong>{badge.label}</strong>
						{badge.sublabel && <span>{badge.sublabel}</span>}
					</div>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.trust-badges {
		background: white;
		border-top: 1px solid rgba(0, 0, 0, 0.06);
		border-bottom: 1px solid rgba(0, 0, 0, 0.06);
		padding: var(--space-xl) var(--site-gutter);
		position: relative;
	}

	/* Subtle gradient wash behind badges */
	.trust-badges::before {
		content: "";
		position: absolute;
		inset: 0;
		background: var(--gradient-mesh, none);
		opacity: 0.5;
		pointer-events: none;
	}

	.badges-strip {
		display: flex;
		justify-content: center;
		flex-wrap: nowrap;
		gap: var(--spacing-xl);
		position: relative;
		z-index: 1;
	}

	.badge {
		display: flex;
		align-items: center;
		gap: var(--spacing-sm);
		padding: var(--space-sm) var(--space-md);
		border-radius: var(--radius-md);
		transition: background 0.25s ease, transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.badge:hover {
		background: var(--color-surface, #f8fafc);
		transform: translateY(-2px);
	}

	.badge-icon {
		width: 40px;
		height: 40px;
		border-radius: var(--radius-sm);
		background: var(--color-primary-light, #e8f0ff);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		transition: background 0.25s ease, transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.badge:hover .badge-icon {
		background: var(--color-primary);
		transform: scale(1.1) rotate(-4deg);
	}

	.badge i {
		font-size: 20px;
		color: var(--color-primary);
		transition: color 0.2s ease;
	}

	.badge:hover .badge-icon i {
		color: white;
	}

	.badge-text {
		display: flex;
		flex-direction: column;
	}

	.badge-text strong {
		font-family: var(--font-body, system-ui);
		font-size: var(--font-size-sm);
		font-weight: 600;
		color: var(--color-text);
		letter-spacing: -0.01em;
	}

	.badge-text span {
		font-size: var(--font-size-xs);
		color: var(--color-muted);
		margin-top: 1px;
	}

	@media (max-width: 768px) {
		.badges-strip {
			gap: var(--spacing-md);
		}

		.badge-text span {
			display: none;
		}

		.badge-icon {
			width: 34px;
			height: 34px;
		}

		.badge i {
			font-size: 18px;
		}
	}
</style>
