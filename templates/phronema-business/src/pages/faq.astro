---
import { getEmDashCollection, getEntryTerms, getTaxonomyTerms } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";

const { entries: faqs, cacheHint } = await getEmDashCollection("faqs", { status: "published" });
if (cacheHint) Astro.response.headers.set("Cache-Control", cacheHint);

const categories = await getTaxonomyTerms("faq_category");

const faqsWithCategories = await Promise.all(
	faqs.map(async (faq) => {
		const terms = await getEntryTerms(faq.id, "faq_category");
		return { faq, category: terms[0]?.label || "General" };
	})
);

const grouped = faqsWithCategories.reduce<Record<string, typeof faqsWithCategories>>((acc, item) => {
	(acc[item.category] ??= []).push(item);
	return acc;
}, {});

const hasFaqs = faqs.length > 0;

const fallbackFaqs = [
	{
		category: "Getting Started",
		items: [
			{
				question: "How do I schedule an initial consultation?",
				answer: "You can schedule a consultation by calling our office at (555) 234-5678, emailing us at contact@caldwellandassociates.com, or by submitting the form on our Contact page. We respond within one business day and offer in-person, phone, and video appointments.",
			},
			{
				question: "Is the initial consultation free?",
				answer: "Yes. We offer a free initial consultation for most matters. This gives us both the opportunity to understand your situation and determine whether we are the right fit for your needs. There is no obligation, and all information you share is confidential.",
			},
			{
				question: "What should I bring to my first consultation?",
				answer: "Bring any documents relevant to your matter — contracts, correspondence, court documents, financial records, or other paperwork you have already gathered. The more context you can provide, the more productive our first meeting will be. If you are not sure what is relevant, bring what you have and we will sort through it together.",
			},
		],
	},
	{
		category: "Fees & Billing",
		items: [
			{
				question: "How do you structure your fees?",
				answer: "Fee structures vary by matter type. We offer flat fees for defined-scope work such as simple estate planning documents, business formation packages, and certain transactional matters. Hourly billing applies to litigation, complex transactions, and ongoing advisory work. We always discuss fees upfront and will not proceed without your clear understanding and agreement.",
			},
			{
				question: "Do you offer payment plans?",
				answer: "We evaluate payment arrangements on a case-by-case basis. For clients who need flexibility, we can often structure retainers and payment schedules that work within your budget while still allowing us to provide effective representation. Please raise this topic during your consultation — it is never an awkward question.",
			},
			{
				question: "Will I be billed for every email and phone call?",
				answer: "We are transparent about billing. Short administrative calls and brief email exchanges are generally not billed, but substantive legal consultations — whether by phone, email, or in person — are billable time. We will set clear expectations at the outset of your engagement so there are no surprises.",
			},
		],
	},
	{
		category: "Confidentiality & Process",
		items: [
			{
				question: "Is everything I tell my attorney kept confidential?",
				answer: "Yes. Attorney-client privilege applies from the moment of your initial consultation, even if you do not ultimately retain us. Anything you share with our attorneys in the context of seeking legal advice is protected by strict confidentiality obligations. We take this seriously as a matter of professional ethics and personal commitment.",
			},
			{
				question: "How long does a typical matter take to resolve?",
				answer: "Timelines vary significantly by matter type. A straightforward will or business formation can often be completed within a week or two. Litigation may take months to years depending on complexity and court schedules. We will give you an honest assessment of realistic timelines — including factors that may be outside our control — at the start of your engagement.",
			},
			{
				question: "Will I work directly with a partner, or will my case be handled by associates?",
				answer: "Partner-led representation is central to how we operate. The partner you meet with is the attorney responsible for your matter. Associates may assist on research and document preparation, but you will always have direct access to your partner, who maintains oversight and strategic control of your case. We do not use junior attorneys as client-facing surrogates.",
			},
		],
	},
];
---

<Base title="Frequently Asked Questions" description="Answers to common questions about working with Caldwell & Associates — consultations, fees, timelines, and what to expect.">
	<PageHero
		title="Frequently Asked Questions"
		subtitle="Answers to common questions about working with us. Can't find what you need? Call or email us directly."
		image="https://images.unsplash.com/photo-1434030216411-0b793f4b4173?w=1600&h=500&fit=crop"
	/>

	<section class="section container faq-layout">

		{/* ===== SIDEBAR NAV ===== */}
		<nav class="faq-nav" aria-label="FAQ categories">
			<p class="faq-nav-label">Jump to</p>
			{hasFaqs ? (
				Object.keys(grouped).map((cat) => (
					<a href={`#faq-${cat.toLowerCase().replace(/\s+/g, "-")}`} class="faq-nav-link">{cat}</a>
				))
			) : (
				fallbackFaqs.map((group) => (
					<a href={`#faq-${group.category.toLowerCase().replace(/\s+/g, "-")}`} class="faq-nav-link">{group.category}</a>
				))
			)}
			<div class="faq-nav-cta">
				<p>Still have questions?</p>
				<a href="/contact" class="btn btn-primary" style="width: 100%; justify-content: center; margin-top: var(--spacing-sm);">Contact Us</a>
				<a href="tel:5552345678" class="faq-phone"><i class="ph ph-phone"></i> (555) 234-5678</a>
			</div>
		</nav>

		{/* ===== FAQ CONTENT ===== */}
		<div class="faq-content">
			{hasFaqs ? (
				<div class="faq-sections">
					{Object.entries(grouped).map(([category, items]) => (
						<div class="faq-category" id={`faq-${category.toLowerCase().replace(/\s+/g, "-")}`}>
							<h2>{category}</h2>
							<div class="faq-list">
								{items.map(({ faq }) => (
									<details class="faq-item">
										<summary>
											<span>{faq.data.question}</span>
											<span class="faq-toggle" aria-hidden="true"></span>
										</summary>
										<div class="faq-answer">
											{faq.data.answer ? (
												<PortableText value={faq.data.answer} />
											) : (
												<p>Answer coming soon.</p>
											)}
										</div>
									</details>
								))}
							</div>
						</div>
					))}
				</div>
			) : (
				<div class="faq-sections">
					{fallbackFaqs.map((group) => (
						<div class="faq-category" id={`faq-${group.category.toLowerCase().replace(/\s+/g, "-")}`}>
							<h2>{group.category}</h2>
							<div class="faq-list">
								{group.items.map((item) => (
									<details class="faq-item">
										<summary>
											<span>{item.question}</span>
											<span class="faq-toggle" aria-hidden="true"></span>
										</summary>
										<div class="faq-answer">
											<p>{item.answer}</p>
										</div>
									</details>
								))}
							</div>
						</div>
					))}
				</div>
			)}

			{/* ===== BOTTOM CTA ===== */}
			<div class="faq-bottom-cta">
				<div class="faq-cta-icon"><i class="ph ph-chat-text"></i></div>
				<div>
					<h3>Still have questions?</h3>
					<p>We are happy to speak with you before you make any commitment. Call us or send a message and one of our attorneys will be in touch within one business day.</p>
				</div>
				<a href="/contact" class="btn btn-primary">Schedule a Free Consultation</a>
			</div>
		</div>

	</section>
</Base>

<style>
	/* ===== Layout ===== */
	.faq-layout {
		display: grid;
		grid-template-columns: 220px 1fr;
		gap: var(--space-4xl);
		align-items: start;
	}

	/* ===== Sidebar ===== */
	.faq-nav {
		position: sticky;
		top: calc(64px + var(--space-xl));
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.faq-nav-label {
		font-family: var(--font-body);
		font-size: 10px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--color-muted);
		margin-bottom: var(--spacing-sm);
	}

	.faq-nav-link {
		font-family: var(--font-body);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		text-decoration: none;
		padding: 7px 10px;
		border-radius: var(--radius-sm);
		transition: background 0.2s ease, color 0.2s ease;
	}

	.faq-nav-link:hover {
		background: var(--color-surface);
		color: var(--color-primary);
	}

	.faq-nav-cta {
		margin-top: var(--spacing-2xl);
		padding: var(--spacing-lg);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
	}

	.faq-nav-cta p {
		font-family: var(--font-body);
		font-size: var(--font-size-sm);
		font-weight: 600;
		margin-bottom: var(--spacing-xs);
	}

	.faq-phone {
		font-family: var(--font-body);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		text-decoration: none;
		display: flex;
		align-items: center;
		gap: 6px;
		justify-content: center;
		margin-top: var(--spacing-sm);
		transition: color 0.2s ease;
	}

	.faq-phone:hover { color: var(--color-primary); }

	.faq-phone i { color: var(--color-primary); }

	/* ===== FAQ sections ===== */
	.faq-sections {
		display: flex;
		flex-direction: column;
		gap: var(--space-3xl);
	}

	.faq-category h2 {
		font-size: var(--font-size-2xl);
		color: var(--color-primary);
		margin-bottom: var(--spacing-xl);
		padding-bottom: var(--spacing-sm);
		border-bottom: 2px solid var(--color-primary-light);
	}

	.faq-list {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-sm);
	}

	.faq-item {
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		overflow: hidden;
		transition: border-color 0.2s ease, box-shadow 0.2s ease;
	}

	.faq-item:hover {
		border-color: color-mix(in srgb, var(--color-primary) 30%, transparent);
	}

	.faq-item[open] {
		border-color: var(--color-primary);
		box-shadow: 0 4px 16px color-mix(in srgb, var(--color-primary) 10%, transparent);
	}

	.faq-item summary {
		padding: var(--spacing-lg) var(--spacing-xl);
		cursor: pointer;
		list-style: none;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: var(--spacing-md);
		font-family: var(--font-display);
		font-size: var(--font-size-lg);
		font-weight: 400;
		transition: color 0.2s ease, background 0.2s ease;
	}

	.faq-item summary::-webkit-details-marker { display: none; }

	.faq-item[open] > summary {
		color: var(--color-primary);
		background: var(--color-surface);
	}

	.faq-toggle {
		width: 28px;
		height: 28px;
		border-radius: 50%;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		position: relative;
		transition: background 0.2s ease, border-color 0.2s ease;
	}

	.faq-toggle::before,
	.faq-toggle::after {
		content: "";
		position: absolute;
		background: var(--color-muted);
		border-radius: 1px;
		transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), background 0.2s ease;
	}

	.faq-toggle::before {
		width: 10px;
		height: 1.5px;
	}

	.faq-toggle::after {
		width: 1.5px;
		height: 10px;
	}

	.faq-item[open] .faq-toggle {
		background: var(--color-primary);
		border-color: var(--color-primary);
	}

	.faq-item[open] .faq-toggle::before,
	.faq-item[open] .faq-toggle::after {
		background: white;
	}

	.faq-item[open] .faq-toggle::after {
		transform: scaleY(0);
	}

	.faq-answer {
		padding: var(--spacing-lg) var(--spacing-xl) var(--spacing-xl);
		border-top: 1px solid var(--color-border);
	}

	.faq-answer p {
		font-family: var(--font-body);
		font-size: var(--font-size-base);
		color: var(--color-muted);
		line-height: 1.75;
		margin-bottom: var(--spacing-sm);
	}

	.faq-answer :global(p) {
		font-family: var(--font-body);
		font-size: var(--font-size-base);
		color: var(--color-muted);
		line-height: 1.75;
		margin-bottom: var(--spacing-sm);
	}

	/* ===== Bottom CTA ===== */
	.faq-bottom-cta {
		display: flex;
		align-items: center;
		gap: var(--spacing-xl);
		padding: var(--spacing-2xl);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		margin-top: var(--space-2xl);
	}

	.faq-cta-icon {
		width: 56px;
		height: 56px;
		border-radius: var(--radius-md);
		background: var(--color-primary-light);
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 26px;
		color: var(--color-primary);
		flex-shrink: 0;
	}

	.faq-bottom-cta h3 {
		font-size: var(--font-size-lg);
		margin-bottom: 4px;
	}

	.faq-bottom-cta p {
		font-family: var(--font-body);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		line-height: 1.6;
	}

	.faq-bottom-cta .btn {
		flex-shrink: 0;
		white-space: nowrap;
	}

	/* ===== Responsive ===== */
	@media (max-width: 900px) {
		.faq-layout {
			grid-template-columns: 1fr;
		}
		.faq-nav {
			position: static;
			flex-direction: row;
			flex-wrap: wrap;
			gap: var(--spacing-sm);
			padding-bottom: var(--spacing-xl);
			border-bottom: 1px solid var(--color-border);
		}
		.faq-nav-label { width: 100%; }
		.faq-nav-cta {
			width: 100%;
			margin-top: var(--spacing-md);
			display: flex;
			align-items: center;
			gap: var(--spacing-md);
		}
		.faq-nav-cta p { margin: 0; }
		.faq-bottom-cta { flex-direction: column; align-items: flex-start; }
	}

	@media (max-width: 600px) {
		.faq-item summary { font-size: var(--font-size-base); }
		.faq-nav-cta { flex-direction: column; align-items: flex-start; }
	}
</style>
