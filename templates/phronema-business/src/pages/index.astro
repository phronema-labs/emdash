---
import { getEmDashEntry, getEmDashCollection } from "emdash";
import { PortableText, Image } from "emdash/ui";
import Base from "../layouts/Base.astro";
import TrustBadges from "../components/TrustBadges.astro";
import BrandStrip from "../components/BrandStrip.astro";
import TestimonialCarousel from "../components/TestimonialCarousel.astro";
import CostEstimator from "../components/CostEstimator.astro";
import ServiceCard from "../components/ServiceCard.astro";
import GoogleReviews from "../components/GoogleReviews.astro";

const { entry, cacheHint } = await getEmDashEntry("pages", "home");
if (cacheHint) Astro.response.headers.set("Cache-Control", cacheHint);

const { entries: services } = await getEmDashCollection("services", { status: "published" });
const { entries: testimonials } = await getEmDashCollection("testimonials", { status: "published" });
const { entries: projects } = await getEmDashCollection("projects", { status: "published" });

const testimonialData = testimonials.map((t) => ({
	quote: t.data.quote,
	author: t.data.author,
	role: t.data.role,
	company: t.data.company,
	rating: t.data.rating as number | undefined,
}));
---

<Base>
	{/* ===== HERO — two-column with video + form ===== */}
	<section class="hero-section">
		<video
			class="hero-video"
			autoplay
			muted
			loop
			playsinline
			preload="auto"
			poster="https://images.unsplash.com/photo-1589829545856-d10d557cf95f?w=1600&h=900&fit=crop"
		>
			<source src="https://assets.mixkit.co/videos/39575/39575-720.mp4" type="video/mp4" />
		</video>
		<div class="hero-overlay"></div>
		<!-- Cinematic vignette -->
		<div class="hero-vignette" aria-hidden="true"></div>
		<div class="container hero-inner">
			<div class="hero-grid">
				<div class="hero-content">
					<span class="hero-badge">
						<span class="hero-badge-dot" aria-hidden="true"></span>
						<i class="ph ph-scales" /> AV Preeminent Rated &middot; Est. 2001
					</span>
					<h1>Counsel you can<br /><em>count on</em></h1>
					<p class="hero-sub">Business law, estate planning, and family law for individuals and companies who deserve experienced, straightforward legal guidance.</p>
					<div class="hero-actions">
						<a href="tel:5552345678" class="btn btn-hero-secondary">
							<i class="ph ph-phone" /> (555) 234-5678
						</a>
					</div>
					<div class="hero-proof">
						<GoogleReviews rating={4.9} reviewCount={217} style="badge" />
					</div>
				</div>
				<div class="hero-form-wrap">
					<span class="hero-form-ribbon"><i class="ph ph-calendar-check" /> Free Consultation</span>
					<form class="hero-form" method="POST" action="/contact">
						<h2 class="hero-form-title">Schedule a Consultation</h2>
						<p class="hero-form-sub">We respond within one business day</p>
						<div class="hero-form-fields">
							<input type="text" name="name" placeholder="Your name" required />
							<input type="tel" name="phone" placeholder="Phone number" required />
							<select name="service">
								<option value="">Practice area...</option>
								<option value="business-law">Business Law</option>
								<option value="estate-planning">Estate Planning</option>
								<option value="family-law">Family Law</option>
								<option value="litigation">Litigation</option>
								<option value="other">Other / Not Sure</option>
							</select>
							<textarea name="message" rows="2" placeholder="Brief description of your matter"></textarea>
							<button type="submit" class="hero-form-btn">
								<i class="ph ph-calendar-check" /> Request Consultation
							</button>
						</div>
						<p class="hero-form-note"><i class="ph ph-lock-simple" /> Confidential. No obligation.</p>
					</form>
				</div>
			</div>
		</div>
	</section>

	{/* ===== TRUST BAR ===== */}
	<TrustBadges />

	{/* ===== SERVICES — light gray bg ===== */}
	{services.length > 0 && (
		<section class="section section-gray section-with-divider">
			<div class="container">
				<div class="section-header reveal">
					<span class="section-label">Practice Areas</span>
					<h2>How we can <em>help</em></h2>
					<p>Experienced attorneys across the matters that matter most to individuals and businesses.</p>
				</div>
				<div class="services-grid reveal-stagger">
					{services.slice(0, 4).map((service) => (
						<ServiceCard
							title={service.data.title}
							summary={service.data.summary}
							icon={service.data.icon}
							priceFrom={service.data.price_from}
							href={`/services/${service.slug}`}
							ctaLabel={service.data.cta_label}
						/>
					))}
				</div>
				<div style="text-align: center; margin-top: var(--spacing-2xl);">
					<a href="/services" class="btn btn-secondary">View All Practice Areas &rarr;</a>
				</div>
			</div>
		</section>
	)}

	{/* ===== STATS — dark section ===== */}
	<section class="section section-dark">
		<div class="container">
			<div class="stats-row reveal-stagger">
				<div class="stat">
					<span class="stat-number">20+</span>
					<span class="stat-label">Years in Practice</span>
				</div>
				<div class="stat-divider"></div>
				<div class="stat">
					<span class="stat-number">1,200+</span>
					<span class="stat-label">Matters Handled</span>
				</div>
				<div class="stat-divider"></div>
				<div class="stat">
					<span class="stat-number">AV <i class="ph ph-star-fill" style="color: #b8860b; font-size: 20px;" /></span>
					<span class="stat-label">Martindale-Hubbell</span>
				</div>
				<div class="stat-divider"></div>
				<div class="stat">
					<span class="stat-number">98%</span>
					<span class="stat-label">Client Retention</span>
				</div>
			</div>
		</div>
	</section>

	{/* ===== WHY CHOOSE US — white bg with mesh gradient ===== */}
	<section class="section bg-mesh">
		<div class="container">
			<div class="section-header reveal">
				<span class="section-label">Why Clients Choose Us</span>
				<h2>The Caldwell <em>difference</em></h2>
				<p>High-quality legal counsel without the big-firm bureaucracy. Partner-led representation from day one.</p>
			</div>
			<div class="why-grid reveal-stagger">
				<div class="why-card">
					<div class="why-icon"><i class="ph ph-handshake" /></div>
					<h3>Direct Partner Access</h3>
					<p>Your matter is handled by a named partner, not handed off to a junior associate. You get experienced counsel, not a learning curve.</p>
					<span class="why-number" aria-hidden="true">01</span>
				</div>
				<div class="why-card">
					<div class="why-icon"><i class="ph ph-currency-dollar" /></div>
					<h3>Transparent Billing</h3>
					<p>Flat fees where possible. Hourly rates disclosed upfront. No bill surprises, no 6-minute email increments, no nickel-and-diming.</p>
					<span class="why-number" aria-hidden="true">02</span>
				</div>
				<div class="why-card">
					<div class="why-icon"><i class="ph ph-seal-check" /></div>
					<h3>Results-Focused Counsel</h3>
					<p>We measure success by your outcome. Our reputation depends on the results we achieve, and we take that responsibility seriously.</p>
					<span class="why-number" aria-hidden="true">03</span>
				</div>
			</div>
		</div>
	</section>

	{/* ===== BRANDS — subtle strip ===== */}
	<BrandStrip />

	{/* ===== TESTIMONIALS — warm accent bg ===== */}
	{testimonialData.length > 0 && (
		<section class="section section-warm">
			<div class="container">
				<div class="section-header reveal">
					<span class="section-label">Client Testimonials</span>
					<h2>What our clients <em>say</em></h2>
					<div style="margin-top: var(--spacing-md);">
						<GoogleReviews rating={4.9} reviewCount={217} style="badge" />
					</div>
				</div>
				<TestimonialCarousel testimonials={testimonialData} />
			</div>
		</section>
	)}

	{/* ===== RECENT PROJECTS — gray bg ===== */}
	{projects.length > 0 && (
		<section class="section section-gray">
			<div class="container">
				<div class="section-header reveal">
					<span class="section-label">Notable Matters</span>
					<h2>Recent <em>engagements</em></h2>
					<p>A selection of recent matters handled across our practice areas. Client identities are protected.</p>
				</div>
				<div class="projects-preview reveal-stagger">
					{projects.slice(0, 3).map((project) => (
						<a href={`/work/${project.slug}`} class="project-preview-card">
							<div class="project-preview-img">
								{project.data.featured_image ? (
									<Image image={project.data.featured_image} />
								) : (
									<img src="https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=600&h=400&fit=crop" alt={project.data.title} loading="lazy" />
								)}
								<span class="project-overlay">View Matter</span>
							</div>
							<div class="project-preview-info">
								<h3>{project.data.title}</h3>
								<p>{project.data.summary}</p>
							</div>
						</a>
					))}
				</div>
				<div style="text-align: center; margin-top: var(--spacing-2xl);">
					<a href="/work" class="btn btn-secondary">View All Notable Matters &rarr;</a>
				</div>
			</div>
		</section>
	)}

	{/* ===== COST ESTIMATOR — white bg ===== */}
	<CostEstimator />

	{/* ===== FINAL CTA — dark brand section ===== */}
	<section class="section section-cta">
		<!-- Decorative orbs -->
		<span class="cta-orb cta-orb-1" aria-hidden="true"></span>
		<span class="cta-orb cta-orb-2" aria-hidden="true"></span>
		<div class="container reveal" style="text-align: center; position: relative; z-index: 1;">
			<span class="section-label" style="color: rgba(255,255,255,0.5);">Ready to Move Forward?</span>
			<h2 style="margin-top: 0.5rem;">Let's discuss your <em>matter</em></h2>
			<p>Schedule a confidential consultation today. In-person, phone, or video — whatever works for you.</p>
			<div class="cta-actions">
				<a href="/contact" class="btn btn-accent btn-lg">Schedule a Consultation</a>
				<a href="tel:5552345678" class="btn btn-outline-light btn-lg">
					<i class="ph ph-phone" /> (555) 234-5678
				</a>
			</div>
		</div>
	</section>
</Base>

<style>
	/* ===== Section styles ===== */
	.section-with-divider {
		position: relative;
		margin-top: -1px;
	}

	.section-with-divider::before {
		content: "";
		position: absolute;
		top: -40px;
		left: 0;
		right: 0;
		height: 40px;
		background: var(--color-surface);
		clip-path: polygon(0 100%, 100% 0, 100% 100%);
		z-index: 1;
	}

	.section-gray { background: var(--color-surface); }
	.section-warm { background: var(--color-surface-warm, #fef8f4); }
	.section-dark {
		background: var(--color-dark-section, #1a2332);
		color: white;
	}
	.section-cta {
		background:
			radial-gradient(ellipse at 20% 60%, color-mix(in srgb, var(--color-accent) 20%, transparent), transparent 50%),
			radial-gradient(ellipse at 80% 30%, color-mix(in srgb, var(--color-primary) 30%, transparent), transparent 60%),
			linear-gradient(140deg, var(--color-primary-dark) 0%, color-mix(in srgb, var(--color-primary) 80%, #000) 100%);
		color: white;
		padding: var(--space-5xl) var(--site-gutter);
		position: relative;
		overflow: hidden;
	}

	.section-cta h2 {
		font-size: clamp(2rem, 4.5vw, 3.25rem);
		color: white;
	}

	.section-cta h2 em {
		font-style: italic;
		color: color-mix(in srgb, var(--color-accent) 90%, white);
	}

	/* Decorative floating orbs */
	.cta-orb {
		position: absolute;
		border-radius: 50%;
		pointer-events: none;
	}

	.cta-orb-1 {
		width: 400px;
		height: 400px;
		top: -150px;
		right: -100px;
		background: radial-gradient(circle, color-mix(in srgb, var(--color-accent) 15%, transparent), transparent 70%);
	}

	.cta-orb-2 {
		width: 300px;
		height: 300px;
		bottom: -120px;
		left: 5%;
		background: radial-gradient(circle, color-mix(in srgb, var(--color-primary-light) 10%, transparent), transparent 70%);
	}

	.section-cta p {
		color: rgba(255,255,255,0.75);
		font-family: var(--font-body, system-ui);
		font-size: var(--font-size-lg);
		margin-top: var(--spacing-md);
		max-width: 480px;
		margin-inline: auto;
		line-height: 1.7;
	}

	/* Section headers */
	.section-header {
		text-align: center;
		margin-bottom: var(--space-3xl);
	}

	.section-label {
		display: inline-block;
		font-family: var(--font-body, system-ui);
		font-size: 11px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: var(--color-primary);
		margin-bottom: var(--spacing-sm);
		background: linear-gradient(
			110deg,
			var(--color-primary) 30%,
			var(--color-accent) 50%,
			var(--color-primary) 70%
		);
		background-size: 200% auto;
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		animation: shimmer 4s ease-in-out infinite;
	}

	.section-header h2 {
		font-size: clamp(1.8rem, 3.5vw, 2.75rem);
	}

	.section-header h2 em {
		font-style: italic;
		color: var(--color-accent);
		-webkit-text-fill-color: var(--color-accent);
	}

	.section-header p {
		color: var(--color-muted);
		font-family: var(--font-body, system-ui);
		font-size: var(--font-size-lg);
		margin-top: var(--spacing-md);
		max-width: 520px;
		margin-inline: auto;
		line-height: 1.7;
	}

	/* ===== Hero ===== */
	.hero-section {
		position: relative;
		background: #0a0f1a;
		display: flex;
		align-items: center;
		overflow: hidden;
		min-height: 640px;
	}

	.hero-video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0.5;
	}

	.hero-overlay {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(135deg, var(--color-dark-section, #030712) 0%, color-mix(in srgb, var(--color-primary) 55%, #000) 100%);
		opacity: 0.88;
	}

	/* Subtle radial vignette at edges */
	.hero-vignette {
		position: absolute;
		inset: 0;
		background: radial-gradient(ellipse at 50% 50%, transparent 50%, rgba(0, 0, 0, 0.45) 100%);
		pointer-events: none;
		z-index: 0;
	}

	.hero-inner {
		position: relative;
		z-index: 1;
		padding: var(--space-5xl) var(--site-gutter);
		width: 100%;
	}

	.hero-grid {
		display: grid;
		grid-template-columns: 1fr 420px;
		gap: var(--spacing-3xl);
		align-items: center;
	}

	.hero-content {
		color: white;
	}

	.hero-badge {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		background: rgba(255,255,255,0.08);
		border: 1px solid rgba(255,255,255,0.15);
		padding: 7px 16px;
		border-radius: 24px;
		font-family: var(--font-body, system-ui);
		font-size: 12px;
		font-weight: 500;
		letter-spacing: 0.02em;
		margin-bottom: var(--spacing-xl);
		position: relative;
		overflow: hidden;
		animation: fadeInUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
	}

	.hero-badge::before {
		content: "";
		position: absolute;
		inset: 0;
		background: linear-gradient(
			110deg,
			transparent 25%,
			rgba(255, 255, 255, 0.06) 40%,
			rgba(255, 255, 255, 0.06) 45%,
			transparent 60%
		);
		background-size: 250% 100%;
		animation: shimmer 4s ease-in-out infinite;
	}

	/* Pulsing live dot */
	.hero-badge-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #22c55e;
		flex-shrink: 0;
		box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.5);
		animation: pulse-dot 2s ease-in-out infinite;
	}

	@keyframes pulse-dot {
		0%, 100% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.5); }
		50% { box-shadow: 0 0 0 5px rgba(34, 197, 94, 0); }
	}

	.hero-badge i {
		color: var(--color-accent);
	}

	.hero-content h1 {
		font-size: clamp(2.2rem, 4.5vw, 3.5rem);
		font-weight: 400;
		line-height: 1.08;
		letter-spacing: -0.02em;
		animation: fadeInUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.35s both;
	}

	.hero-content h1 em {
		font-style: italic;
		color: color-mix(in srgb, var(--color-accent) 85%, white);
	}

	.hero-sub {
		font-family: var(--font-body, system-ui);
		font-size: var(--font-size-lg);
		line-height: 1.7;
		color: rgba(255,255,255,0.75);
		margin-top: var(--spacing-md);
		max-width: 460px;
		animation: fadeInUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.5s both;
	}

	.hero-actions {
		display: flex;
		gap: var(--spacing-md);
		flex-wrap: wrap;
		margin-top: var(--spacing-lg);
		animation: fadeInUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.65s both;
	}

	.hero-actions .btn-hero-secondary {
		background: transparent;
		color: white;
		border: 2px solid rgba(255,255,255,0.3);
		padding: 10px 20px;
		font-size: var(--font-size-sm);
		font-weight: 600;
		border-radius: var(--radius-sm);
		display: inline-flex;
		align-items: center;
		gap: 8px;
		text-decoration: none;
		transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
	}

	.hero-actions .btn-hero-secondary:hover {
		background: rgba(255,255,255,0.1);
		border-color: rgba(255,255,255,0.6);
		transform: translateY(-1px);
	}

	.hero-proof {
		margin-top: var(--spacing-lg);
		animation: fadeInUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.8s both;
	}

	/* Hero form */
	.hero-form-wrap {
		animation: fadeInUp 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.4s both;
		position: relative;
	}

	.hero-form-ribbon {
		position: absolute;
		top: -12px;
		right: 20px;
		z-index: 2;
		background: var(--color-accent, #e00000);
		color: white;
		font-family: var(--font-body, system-ui);
		font-size: 10px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		padding: 6px 14px;
		border-radius: 6px 6px 6px 0;
		box-shadow: 0 4px 16px color-mix(in srgb, var(--color-accent) 40%, transparent);
		display: flex;
		align-items: center;
		gap: 5px;
		animation: pulse-glow 2s ease-in-out infinite;
	}

	.hero-form-ribbon::before {
		content: "";
		position: absolute;
		left: 0;
		bottom: -6px;
		width: 0;
		height: 0;
		border-style: solid;
		border-width: 6px 8px 0 0;
		border-color: color-mix(in srgb, var(--color-accent) 70%, #000) transparent transparent transparent;
	}

	.hero-form-ribbon i {
		font-size: 13px;
	}

	.hero-form {
		background: rgba(255, 255, 255, 0.97);
		border-radius: var(--radius-lg);
		padding: var(--spacing-2xl) var(--spacing-xl);
		box-shadow: 0 32px 64px rgba(0, 0, 0, 0.3), 0 0 0 1px rgba(255, 255, 255, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.8);
		position: relative;
		backdrop-filter: blur(4px);
	}

	/* Top accent gradient on form */
	.hero-form::before {
		content: "";
		position: absolute;
		top: 0;
		left: 24px;
		right: 24px;
		height: 2px;
		background: linear-gradient(90deg, var(--color-primary), var(--color-accent));
		border-radius: 0 0 2px 2px;
	}

	.hero-form-title {
		font-size: var(--font-size-2xl);
		font-weight: 400;
		color: var(--color-text);
		margin-bottom: 4px;
		letter-spacing: -0.02em;
	}

	.hero-form-sub {
		font-family: var(--font-body, system-ui);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
		margin-bottom: var(--spacing-xl);
	}

	.hero-form-fields {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.hero-form-fields input,
	.hero-form-fields select,
	.hero-form-fields textarea {
		width: 100%;
		padding: 11px 14px;
		border: 1.5px solid rgba(0, 0, 0, 0.1);
		border-radius: var(--radius-sm);
		font-family: var(--font-body, system-ui);
		font-size: var(--font-size-sm);
		color: var(--color-text);
		background: rgba(248, 250, 252, 0.8);
		transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
	}

	.hero-form-fields input::placeholder,
	.hero-form-fields textarea::placeholder {
		color: var(--color-muted);
		opacity: 0.55;
	}

	.hero-form-fields input:focus,
	.hero-form-fields select:focus,
	.hero-form-fields textarea:focus {
		outline: none;
		border-color: var(--color-primary);
		background: white;
		box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 12%, transparent);
	}

	.hero-form-fields textarea {
		resize: vertical;
		min-height: 52px;
	}

	.hero-form-btn {
		width: 100%;
		padding: 14px;
